---
// CookieConsent.astro - Modal Centrado Bloqueante de Alta Conversión (RGPD & AEPD 2024)
import { useTranslations } from '../utils/i18n';

interface Props {
  lang?: 'es' | 'en' | 'fr';
  gaId?: string;
}

const { lang = 'es', gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || '' } = Astro.props;
---

<div id="cookie-backdrop" class="cookie-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="cookie-title">
  <div class="cookie-modal">
    <div class="cookie-icon" aria-hidden="true">🍪</div>
    <h2 id="cookie-title" class="cookie-title">
      {lang === 'es' ? 'Privacidad y Medición de Salud' : lang === 'en' ? 'Privacy & Health Analytics' : 'Confidentialité & Mesure de Santé'}
    </h2>
    <p class="cookie-description">
      {lang === 'es' 
        ? 'Utilizamos cookies analíticas para medir las visitas y entender qué contenidos te resultan más útiles. Para navegar por la web y ayudarnos con estas métricas, por favor selecciona tu preferencia:'
        : lang === 'en'
        ? 'We use analytical cookies to measure visits and understand which health content is most useful to you. Please select your preference:'
        : 'Nous utilisons des cookies analytiques pour mesurer les visites et comprendre quels contenus vous sont les plus utiles. Veuillez choisir votre préférence :'}
    </p>
    
    <div class="cookie-actions-vertical">
      <button id="cookie-accept-btn" class="cookie-btn cookie-btn-primary">
        {lang === 'es' ? 'Aceptar y Continuar' : lang === 'en' ? 'Accept & Continue' : 'Accepter & Continuer'}
      </button>
      <button id="cookie-reject-btn" class="cookie-btn cookie-btn-secondary">
        {lang === 'es' ? 'Continuar solo con cookies necesarias' : lang === 'en' ? 'Continue with necessary cookies only' : 'Continuer avec cookies nécessaires uniquement'}
      </button>
    </div>

    <p style="margin-top: 15px; font-size: 0.75rem; color: var(--text-muted);">
      <a href={lang === 'es' ? '/aviso-legal' : `/${lang}/aviso-legal`} style="color: var(--color-secondary); text-decoration: underline;">
        {lang === 'es' ? 'Más información en nuestra Política de Privacidad y Cookies' : lang === 'en' ? 'More information in our Privacy & Cookie Policy' : 'Plus d\'informations dans notre Politique de Confidentialité'}
      </a>
    </p>
  </div>
</div>

<style>
  .cookie-backdrop {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.65) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 999999 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .cookie-modal {
    max-width: 480px;
    width: 100%;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--border-color, #e0e0e0);
    border-radius: 16px;
    padding: 35px 25px;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
    text-align: center;
    animation: modalPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .cookie-icon {
    font-size: 2.8rem;
    margin-bottom: 12px;
  }

  .cookie-title {
    font-size: 1.3rem;
    margin: 0 0 10px 0;
    color: var(--text-color, #222222);
    font-weight: 700;
  }

  .cookie-description {
    font-size: 0.9rem;
    color: var(--text-muted, #555555);
    line-height: 1.55;
    margin-bottom: 25px;
  }

  .cookie-actions-vertical {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cookie-btn {
    width: 100%;
    padding: 13px 20px;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .cookie-btn-primary {
    background-color: var(--color-secondary, #336367);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(51, 99, 103, 0.3);
  }

  .cookie-btn-primary:hover {
    background-color: #274d50;
    transform: translateY(-1px);
  }

  .cookie-btn-secondary {
    background-color: transparent;
    border: 1px solid var(--border-color, #cccccc);
    color: var(--text-color, #444444);
  }

  .cookie-btn-secondary:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }
</style>

<script is:inline define:vars={{ gaId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('cookie-backdrop');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const rejectBtn = document.getElementById('cookie-reject-btn');

    const consent = localStorage.getItem('cesar_cookie_consent');

    if (!consent) {
      if (backdrop) {
        backdrop.style.display = 'flex';
        document.body.style.overflow = 'hidden'; // Bloquea el scroll del fondo
      }
    } else if (consent === 'accepted') {
      enableAnalytics();
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cesar_cookie_consent', 'accepted');
        if (backdrop) backdrop.style.display = 'none';
        document.body.style.overflow = ''; // Libera el scroll
        enableAnalytics();
      });
    }

    if (rejectBtn) {
      rejectBtn.addEventListener('click', () => {
        localStorage.setItem('cesar_cookie_consent', 'rejected');
        if (backdrop) backdrop.style.display = 'none';
        document.body.style.overflow = ''; // Libera el scroll
      });
    }

    function enableAnalytics() {
      if (!gaId || window.gtagLoaded) return;
      window.gtagLoaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { 'anonymize_ip': true });
    }
  });
</script>
