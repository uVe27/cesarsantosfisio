---
// CookieConsent.astro - Modal Centrado Bloqueante con Alta Legibilidad y Contraste WCAG AAA (RGPD)
import { useTranslations } from '../utils/i18n';

interface Props {
  lang?: 'es' | 'en' | 'fr';
  gaId?: string;
}

const { lang = 'es', gaId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || 'G-YEQ62CFDFF' } = Astro.props;
---

<div id="p-privacy-modal-overlay" class="p-privacy-modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="p-privacy-title">
  <div class="p-privacy-card">
    <div class="p-privacy-icon" aria-hidden="true">🍪</div>
    
    <h2 id="p-privacy-title" class="p-privacy-title">
      {lang === 'es' ? 'Privacidad y Medición de Salud' : lang === 'en' ? 'Privacy & Health Analytics' : 'Confidentialité & Mesure de Santé'}
    </h2>
    
    <p class="p-privacy-desc">
      {lang === 'es' 
        ? 'Utilizamos cookies analíticas para medir las visitas y entender qué contenidos te resultan más útiles. Para navegar por la web y ayudarnos con estas métricas, por favor selecciona tu preferencia:'
        : lang === 'en'
        ? 'We use analytical cookies to measure visits and understand which health content is most useful to you. Please select your preference:'
        : 'Nous utilisons des cookies analytiques pour mesurer les visites et comprendre quels contenus vous sont les plus utiles. Veuillez choisir votre préférence :'}
    </p>
    
    <div class="p-privacy-actions">
      <button id="p-accept-btn" type="button" class="p-privacy-btn p-btn-primary">
        {lang === 'es' ? 'Aceptar y Continuar' : lang === 'en' ? 'Accept & Continue' : 'Accepter & Continuer'}
      </button>
      <button id="p-reject-btn" type="button" class="p-privacy-btn p-btn-secondary">
        {lang === 'es' ? 'Continuar solo con cookies necesarias' : lang === 'en' ? 'Continue with necessary cookies only' : 'Continuer avec cookies nécessaires uniquement'}
      </button>
    </div>

    <p class="p-privacy-footer-text">
      <a href={lang === 'es' ? '/aviso-legal' : `/${lang}/aviso-legal`} class="p-privacy-link">
        {lang === 'es' ? 'Más información en nuestra Política de Privacidad y Cookies' : lang === 'en' ? 'More information in our Privacy & Cookie Policy' : 'Plus d\'informations dans notre Politique de Confidentialité'}
      </a>
    </p>
  </div>
</div>

<style>
  .p-privacy-modal-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(10, 15, 18, 0.75) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    z-index: 999999 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .p-privacy-card {
    max-width: 500px;
    width: 100%;
    background-color: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #d1dbe0);
    border-radius: 20px;
    padding: 36px 28px;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    text-align: center;
    animation: pPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    color: var(--text-color, #1e293b);
  }

  :global(.dark) .p-privacy-card {
    background-color: #222c31 !important;
    border-color: #3b4d57 !important;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
  }

  @keyframes pPop {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(18px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .p-privacy-icon {
    font-size: 2.8rem;
    margin-bottom: 14px;
    line-height: 1;
  }

  .p-privacy-title {
    font-size: 1.35rem;
    margin: 0 0 12px 0;
    color: var(--color-primary, #1e293b);
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  :global(.dark) .p-privacy-title {
    color: #ffffff !important;
  }

  .p-privacy-desc {
    font-size: 0.93rem;
    color: var(--text-muted, #475569);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  :global(.dark) .p-privacy-desc {
    color: #cbd5e1 !important;
  }

  .p-privacy-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .p-privacy-btn {
    width: 100%;
    padding: 13px 20px;
    border-radius: 10px;
    font-size: 0.94rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Primary Button (Accept) */
  .p-btn-primary {
    background-color: var(--color-secondary, #336367);
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(51, 99, 103, 0.35);
  }

  .p-btn-primary:hover {
    background-color: #274d50;
    color: #ffffff !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(51, 99, 103, 0.45);
  }

  :global(.dark) .p-btn-primary {
    background-color: #5ca1a8 !important;
    color: #071114 !important;
    border: 1px solid #7ecbd2;
    box-shadow: 0 4px 16px rgba(92, 161, 168, 0.3);
  }

  :global(.dark) .p-btn-primary:hover {
    background-color: #7ecbd2 !important;
    color: #02080a !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(126, 203, 210, 0.45);
  }

  /* Secondary Button (Reject optional) */
  .p-btn-secondary {
    background-color: transparent;
    border: 1.5px solid var(--border-color, #cbd5e1);
    color: var(--text-color, #334155);
  }

  .p-btn-secondary:hover {
    background-color: rgba(0, 0, 0, 0.05);
    border-color: var(--color-secondary, #336367);
    transform: translateY(-1px);
  }

  :global(.dark) .p-btn-secondary {
    border-color: #4a5d68 !important;
    color: #e2e8f0 !important;
    background-color: rgba(255, 255, 255, 0.03);
  }

  :global(.dark) .p-btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.09) !important;
    border-color: #5ca1a8 !important;
    color: #ffffff !important;
    transform: translateY(-1px);
  }

  .p-privacy-footer-text {
    margin-top: 20px;
    margin-bottom: 0;
    font-size: 0.82rem;
  }

  .p-privacy-link {
    color: var(--color-secondary, #336367);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .p-privacy-link:hover {
    color: var(--color-primary, #1e293b);
  }

  :global(.dark) .p-privacy-link {
    color: #7ecbd2 !important;
  }

  :global(.dark) .p-privacy-link:hover {
    color: #ffffff !important;
  }
</style>

<script is:inline define:vars={{ gaId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('p-privacy-modal-overlay');
    const acceptBtn = document.getElementById('p-accept-btn');
    const rejectBtn = document.getElementById('p-reject-btn');

    const consent = localStorage.getItem('cesar_cookie_consent');

    if (!consent && overlay) {
      overlay.style.display = 'flex';

      // Verification check: Only lock body scroll if modal is ACTUALLY visible on screen
      setTimeout(() => {
        const computedStyle = window.getComputedStyle(overlay);
        if (computedStyle.display !== 'none' && computedStyle.visibility !== 'hidden' && overlay.offsetHeight > 0) {
          document.body.style.overflow = 'hidden';
        }
      }, 60);
    } else if (consent === 'accepted') {
      enableAnalytics();
    }

    function unlockScroll() {
      if (overlay) overlay.style.display = 'none';
      document.body.style.overflow = '';
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cesar_cookie_consent', 'accepted');
        unlockScroll();
        enableAnalytics();
      });
    }

    if (rejectBtn) {
      rejectBtn.addEventListener('click', () => {
        localStorage.setItem('cesar_cookie_consent', 'rejected');
        unlockScroll();
      });
    }

    // Reopen cookie modal at any time from footer button or link
    const openBtn = document.getElementById('open-cookies-btn');
    if (openBtn) {
      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (overlay) {
          overlay.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    }

    function enableAnalytics() {
      if (!gaId || window.gtagLoaded) return;
      window.gtagLoaded = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { 'anonymize_ip': true });
    }
  });
</script>
