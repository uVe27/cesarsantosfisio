---
interface Props {
  className?: string;
}

const { className = "brand-logo-img" } = Astro.props;
---

<svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 300 210" 
  fill="none" 
  class={className}
  aria-label="Cesar Santos - Fisioterapia y Salud"
  role="img"
>
  <style>
    .brand-svg-vertebra { 
      fill: #336367; 
      transition: fill 0.3s ease;
    }
    .brand-svg-title { 
      font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
      font-weight: 700; 
      font-size: 26px; 
      letter-spacing: 0.12em; 
      fill: #303E45; 
      text-anchor: middle; 
      transition: fill 0.3s ease;
    }
    .brand-svg-subtitle { 
      font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
      font-weight: 600; 
      font-size: 13px; 
      letter-spacing: 0.16em; 
      fill: #336367; 
      text-anchor: middle; 
      transition: fill 0.3s ease;
    }

    :global(.dark) .brand-svg-vertebra { 
      fill: #5CA1A8 !important; 
    }
    :global(.dark) .brand-svg-title { 
      fill: #EBF1F0 !important; 
    }
    :global(.dark) .brand-svg-subtitle { 
      fill: #5CA1A8 !important; 
    }
  </style>

  <!-- Vertebra Spine Curves of Cesar Santos Brand -->
  <g class="brand-svg-vertebra" transform="translate(100, 5) scale(1)">
    <!-- Superior Vertebra -->
    <path d="M 22 26 C 35 14, 65 14, 78 26 C 70 34, 30 34, 22 26 Z" />
    <circle cx="50" cy="20" r="4.5" />
    
    <!-- Middle Vertebra -->
    <path d="M 18 48 C 35 35, 65 35, 82 48 C 73 57, 27 57, 18 48 Z" />
    <circle cx="50" cy="42" r="5.5" />
    
    <!-- Inferior Vertebra -->
    <path d="M 14 71 C 35 57, 65 57, 86 71 C 76 81, 24 81, 14 71 Z" />
    <circle cx="50" cy="65" r="6.5" />
    
    <!-- Spine Base -->
    <path d="M 44 79 L 56 79 L 53 91 L 47 91 Z" />
  </g>

  <!-- Brand Typography -->
  <text x="150" y="146" class="brand-svg-title">CESAR SANTOS</text>
  <text x="150" y="176" class="brand-svg-subtitle">FISIOTERAPIA Y SALUD</text>
</svg>
