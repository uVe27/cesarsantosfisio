---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../utils/i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout 
  title="Contact & Collaborations" 
  description="Contact Cesar Santos for keynotes, health questions or scientific communication collaborations." 
  lang={lang} 
  canonicalPath="/en/contact"
>
  <div class="article-detail" style="max-width: 1000px;">
    <span class="hero-subtitle">Direct Contact & Orientation</span>
    <h1 class="hero-title" style="margin-bottom: 30px;">
      Physiotherapist · Contact & Clinical Orientation
    </h1>

    <div class="contact-layout">
      <!-- Media Kit Info -->
      <section aria-labelledby="collaboration-heading">
        <h2 id="collaboration-heading" style="font-size: 1.3rem; margin-bottom: 15px;">
          Let's talk!
        </h2>
        <p style="color: var(--text-muted); margin-bottom: 25px;">
          I am available to answer your questions about pain, collaborate with media, participate in health podcasts, or give accessible health talks for the general public.
        </p>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; margin-bottom: 30px;" role="list">
          <li style="display: flex; align-items: start; gap: 10px; font-size: 0.95rem;">
            <span style="color: var(--color-secondary); font-weight: bold;" aria-hidden="true">&#10003;</span>
            <span>Educational talks about pain and habits for companies or local groups.</span>
          </li>
          <li style="display: flex; align-items: start; gap: 10px; font-size: 0.95rem;">
            <span style="color: var(--color-secondary); font-weight: bold;" aria-hidden="true">&#10003;</span>
            <span>Interviews for radio, podcasts, television, and print media.</span>
          </li>
          <li style="display: flex; align-items: start; gap: 10px; font-size: 0.95rem;">
            <span style="color: var(--color-secondary); font-weight: bold;" aria-hidden="true">&#10003;</span>
            <span>Writing and reviewing ethical, accessible health information content.</span>
          </li>
        </ul>
      </section>

      <!-- Contact Form / Action Box -->
      <section aria-labelledby="form-heading" class="contact-card">
        <h2 id="form-heading" style="font-size: 1.3rem; margin-bottom: 10px;">
          Send Message
        </h2>
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 25px;">
          All fields are required. You will receive a response within 48 business hours.
        </p>

        <form action="https://formsubmit.co/masthorth_csc@hotmail.com" method="POST">
          <input type="hidden" name="_subject" value="New message from Cesar Santos Website (EN)" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <div class="form-group">
            <label for="name" class="form-label">
              Full Name
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="form-control"
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">
              Email Address
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="form-control"
            />
          </div>

          <div class="form-group">
            <label for="message" class="form-label">
              Message / Collaboration Proposal
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required 
              class="form-control"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="btn-submit"
          >
            Send Inquiry
          </button>
        </form>
      </section>
    </div>
  </div>
</Layout>
