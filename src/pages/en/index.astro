---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../utils/i18n';

const lang = 'en';
const t = useTranslations(lang);

const allArticles = await getCollection('blog');
const enArticles = allArticles
  .filter(item => item.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Cesar Santos | Integrative Physiotherapy, Pain Neuroscience & PNI",
  "description": "Evidence-based physiotherapy for persistent pain, herniated discs, graded activity pacing, and Clinical Psychoneuroimmunology (PNI).",
  "medicalSpecialty": "Physiotherapy",
  "mainEntity": {
    "@type": "Person",
    "name": "Cesar Santos",
    "givenName": "Cesar",
    "familyName": "Santos",
    "jobTitle": "Physiotherapist Specializing in Persistent Pain & Integrative Health",
    "knowsAbout": [
      "Evidence-Based Musculoskeletal Physiotherapy",
      "Pain Neuroscience & Central Sensitization",
      "Clinical Psychoneuroimmunology (PNI)",
      "Graded Activity & Pacing Exercise",
      "Herniated Disc & Low Back Pain Management"
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "ONCE University School of Physiotherapy · Autonomous University of Madrid (UAM)"
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I exercise if I have a herniated disc or disc wear on my lumbar MRI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Clinical evidence shows that herniated discs and disc dehydration appear in 35% of pain-free adults over 40. With an integrative physiotherapy plan and graded activity pacing, you can rebuild strength and move safely."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between strict rest and active coping (pacing)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prolonged rest weakens stabilizing muscles and increases nervous system sensitivity. Active coping replaces immobility with time-based movement quotas (pacing) so your brain gradually decouples movement from danger."
      }
    },
    {
      "@type": "Question",
      "name": "How does Clinical Psychoneuroimmunology (PNI) integrate into physiotherapy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PNI examines the interactions between the nervous, immune, and endocrine systems. In clinical practice, it helps evaluate sleep, circadian rhythms, chronic stress, and low-grade inflammation that influence tissue recovery and pain sensitivity."
      }
    },
    {
      "@type": "Question",
      "name": "Does pain neuroscience education actually help reduce physical pain?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Understanding how pain operates lowers threat signaling in the amygdala and engages descending inhibitory control from the prefrontal cortex."
      }
    }
  ]
};

const schemaJson = JSON.stringify([schema, faqSchema]);
---

<Layout
  title="Physiotherapy & Chronic Pain | Cesar Santos · Integrative Health & Exercise"
  description="Evidence-based physiotherapy specializing in persistent pain neuroscience, herniated discs, graded activity pacing, and Clinical Psychoneuroimmunology (PNI)."
  lang={lang}
  canonicalPath="/en"
  schemaJson={schemaJson}
>
  <!-- Editorial Hero Section (No portrait duplication; patient-first clinical entry panel) -->
  <section class="hero-section" aria-labelledby="manifesto-heading">
    <div class="hero-grid">
      <div>
        <h1 id="manifesto-heading" class="hero-title">
          Physiotherapist in persistent pain and integrative health
        </h1>
        <p class="hero-description">
          If you have been dealing with back pain for months, worry about an MRI report, or feel that fear of movement holds back your daily life, we combine evidence-based physiotherapy, graded exercise, and Clinical Psychoneuroimmunology (PNI) to restore your autonomy.
        </p>

        <div class="hero-actions">
          <a href={getLocalizedPath('/coping-guide', lang)} class="btn-submit" style="width: auto;">
            Build your coping plan &rarr;
          </a>
          <a href={getLocalizedPath('/demystifying-pain', lang)} class="btn-link">
            Read scientific evidence
          </a>
        </div>

        <div class="hero-byline">
          <span><strong>Cesar Santos</strong> · ONCE University School of Physiotherapy (UAM).</span>
          <a href={getLocalizedPath('/about-me', lang)} class="inline-text-link">Read my background &rarr;</a>
        </div>
      </div>

      <!-- Clinical Starting Point Panel -->
      <aside class="triage-panel" aria-labelledby="triage-heading">
        <h2 id="triage-heading" class="triage-panel-title">Where to start today?</h2>
        <p class="triage-panel-sub">Select the situation closest to what you are experiencing:</p>

        <ul class="triage-list">
          <li class="triage-item">
            <a href="/en/demystifying-pain/mri-age-not-pain" class="triage-link">
              <span>
                <span class="triage-link-title">I have a herniated disc or wear on my MRI</span>
                <span class="triage-link-desc">What imaging findings mean and why safe movement remains possible.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          <li class="triage-item">
            <a href="/en/demystifying-pain/brain-brake-prefrontal-control" class="triage-link">
              <span>
                <span class="triage-link-title">My pain has lasted more than 3 months</span>
                <span class="triage-link-desc">How nervous system sensitization and prefrontal pain inhibition work.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          <li class="triage-item">
            <a href="/en/coping-guide" class="triage-link">
              <span>
                <span class="triage-link-title">I want to resume exercise without flare-ups</span>
                <span class="triage-link-desc">Calculate your safe daily movement quota using graded pacing.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        </ul>

        <p class="triage-evidence-note">
          <strong>Clinical data:</strong> <span class="triage-stat-num">35%</span> of pain-free adults over 40 show herniated discs on lumbar MRI (Varun S. et al., 2025).
        </p>
      </aside>
    </div>

    <!-- Authority Trust Bar -->
    <div class="trust-bar" role="region" aria-label="Accreditations & Training">
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>ONCE University School of Physiotherapy (UAM)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Master's in Musculoskeletal Physiotherapy (OMT)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Clinical Psychoneuroimmunology (PNI)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Therapeutic Exercise & Pilates Method</span>
      </div>
    </div>
  </section>

  <!-- Common Conditions / Editorial 2-Column Index -->
  <section class="home-section" aria-labelledby="conditions-heading">
    <div class="section-intro">
      <h2 id="conditions-heading" class="section-title">
        What pain or limitation is holding you back?
      </h2>
      <p class="section-lead">
        Physical pain rarely equals irreversible structural damage. Find your situation below and review what current clinical evidence shows.
      </p>
    </div>

    <div class="conditions-grid">
      <article class="condition-row">
        <div>
          <span class="condition-tag">Lumbar spine</span>
          <h3 class="condition-title">Lower back pain and lumbar locking</h3>
          <p class="condition-desc">
            Morning stiffness, sharp pain when bending forward, or feeling locked up. The lumbar spine is a strong biological structure built to tolerate load and move.
          </p>
        </div>
        <a href="/en/coping-guide" class="editorial-link">
          Calculate graded exercise &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Nerve chain</span>
          <h3 class="condition-title">Sciatica and radiating leg pain</h3>
          <p class="condition-desc">
            Burning, tingling, or shooting discomfort traveling from the glute down the thigh and foot. We assess neurodynamic sensitivity and the functional source of irritation.
          </p>
        </div>
        <a href="/en/contact" class="editorial-link">
          Request clinical consultation &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Diagnostic imaging</span>
          <h3 class="condition-title">Herniated discs and MRI findings</h3>
          <p class="condition-desc">
            If you were told you have disc wear or a protrusion and fear lifting weights, clinical research shows that an MRI scan is only one partial piece of the picture.
          </p>
        </div>
        <a href="/en/demystifying-pain/mri-age-not-pain" class="editorial-link">
          Read evidence on herniated discs &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Cervical region</span>
          <h3 class="condition-title">Neck pain and shoulder tension</h3>
          <p class="condition-desc">
            Trapezius tightness, restricted neck rotation, and tension headaches following long desk hours and accumulated daily stress.
          </p>
        </div>
        <a href="/en/demystifying-pain/balance-statues-dynamic-stability" class="editorial-link">
          Review cervical mobility keys &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Alarm system</span>
          <h3 class="condition-title">Persistent pain lasting over 3 months</h3>
          <p class="condition-desc">
            Ongoing discomfort that continues despite rest or medication. We assess nervous system hypersensitivity alongside sleep and lifestyle load.
          </p>
        </div>
        <a href="/en/demystifying-pain/brain-brake-prefrontal-control" class="editorial-link">
          Understand the pain alarm &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Tissue and tendon</span>
          <h3 class="condition-title">Tendinopathies, shoulder and plantar fasciitis</h3>
          <p class="condition-desc">
            Sharp pain when raising your arm (rotator cuff), Achilles tendon stiffness, or morning heel pain. Tendons rebuild load tolerance through structured, progressive loading.
          </p>
        </div>
        <a href="/en/coping-guide" class="editorial-link">
          Load management strategies &rarr;
        </a>
      </article>
    </div>
  </section>

  <!-- The 4 Pillars of Integrative Health (Full-Bleed Tonal Asymmetric Band) -->
  <section class="full-bleed-band" aria-labelledby="pillars-heading">
    <div class="band-inner">
      <div class="pillars-layout">
        <div class="pillars-intro-sticky">
          <h2 id="pillars-heading" class="section-title">
            The 4 pillars of integrative physiotherapy and PNI
          </h2>
          <p class="section-lead" style="margin-bottom: 24px;">
            Treating only the exact spot that hurts often leads to recurring flare-ups. <strong>Integrative Health</strong> and <strong>Clinical Psychoneuroimmunology (PNI)</strong> evaluate the full map: how you move, how your nervous system reacts, how you sleep, and which daily habits keep your pain alarm active.
          </p>
          <a href="/en/about-me" class="editorial-link">
            Clinical approach and credentials &rarr;
          </a>
        </div>

        <div class="pillars-grid">
          <article class="pillar-card">
            <span class="card-number-tag">01 · Manual Therapy</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Hands-on manual therapy
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Targeted manual techniques to calm acute pain and ease stiff joints or guarded muscles. They provide an opening window of relief so you can begin moving with confidence.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">02 · Exercise & Pilates</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Therapeutic exercise and Pilates
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Properly dosed movement carries the strongest clinical backing. We design progressive routines to rebuild spinal strength, refine motor control, and restore trust in your body.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">03 · Lifestyle & PNI</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Clinical Psychoneuroimmunology (PNI)
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Pain interacts continuously with the rest of your physiology. Poor sleep, sustained stress, or low-grade inflammation lowers your pain threshold. PNI helps adjust these drivers for lasting results.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">04 · Pain Science</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Pain neuroscience education
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Understanding what happens in your body physically alters how intense symptoms feel. Clear explanations around MRIs and tissue resilience help your brain turn down unnecessary threat signals.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Myth Buster Section (Semantic Buttons) -->
  <section class="home-section" aria-labelledby="myths-heading">
    <div class="section-intro">
      <h2 id="myths-heading" class="section-title">
        Common beliefs versus clinical evidence
      </h2>
      <p class="section-lead">
        Select any card to compare widespread assumptions about back pain with findings from peer-reviewed medical research.
      </p>
    </div>

    <div class="myth-grid" role="region" aria-label="Pain Myths and Realities">
      <button type="button" class="myth-card" aria-expanded="false" data-open-label="See evidence →" data-close-label="Back to belief">
        <span class="myth-front">
          <span class="myth-label">Common belief</span>
          <span class="myth-title">“I have a herniated disc on my MRI, so my spine is permanently damaged.”</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Clinical evidence</span>
          <strong>35% of people over 40 have herniated discs without any pain</strong> (Varun S. et al., 2025). Imaging reflects normal age-related changes, much like gray hair or skin wrinkles.
        </span>
        <span class="myth-action-hint">See evidence &rarr;</span>
      </button>

      <button type="button" class="myth-card" aria-expanded="false" data-open-label="See evidence →" data-close-label="Back to belief">
        <span class="myth-front">
          <span class="myth-label">Common belief</span>
          <span class="myth-title">“I must hold one perfect upright posture to prevent back pain.”</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Clinical evidence</span>
          <strong>No single ideal posture exists.</strong> Clinical reviews find no direct causal link between static posture and back pain. Regular variation matters most: your best posture is your next one.
        </span>
        <span class="myth-action-hint">See evidence &rarr;</span>
      </button>

      <button type="button" class="myth-card" aria-expanded="false" data-open-label="See evidence →" data-close-label="Back to belief">
        <span class="myth-front">
          <span class="myth-label">Common belief</span>
          <span class="myth-title">“If movement hurts, I must be tearing or damaging my tissues.”</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Clinical evidence</span>
          <strong>Persistent pain works as a sensitized protection alarm.</strong> It fires well before real tissue injury occurs. Graded, adapted movement retrains your nervous system to recalibrate sensitivity.
        </span>
        <span class="myth-action-hint">See evidence &rarr;</span>
      </button>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="home-section" style="padding-top: 20px;" aria-labelledby="articles-heading">
    <div class="section-header">
      <div>
        <h2 id="articles-heading" class="section-title" style="margin-bottom: 6px;">
          {t('latestPosts')}
        </h2>
        <p class="section-lead">Peer-reviewed PubMed studies translated into practical guidance.</p>
      </div>
      <a href="/en/demystifying-pain" class="btn-link">
        {t('viewAll')} &rarr;
      </a>
    </div>

    <div class="articles-grid">
      {enArticles.map((article) => {
        const cleanSlug = article.id.replace(/^en\//, '');
        return (
          <article class="article-card">
            <span class="article-category">
              {article.data.category}
            </span>
            <h3 class="article-title">
              <a href={`/en/demystifying-pain/${cleanSlug}`}>
                {article.data.title}
              </a>
            </h3>
            <p class="article-description">
              {article.data.description}
            </p>
            <div class="article-footer">
              <time datetime={article.data.pubDate.toISOString()}>
                {new Date(article.data.pubDate).toLocaleDateString('en-US', { dateStyle: 'medium' })}
              </time>
              {article.data.doi && <span class="doi-badge">DOI: {article.data.doi.split('/')[1] || article.data.doi}</span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- FAQ Section (Editorial 2-Column Layout with FAQPage Schema) -->
  <section class="home-section" aria-labelledby="faq-heading">
    <div class="faq-layout">
      <div>
        <h2 id="faq-heading" class="section-title">
          Frequently asked questions on health and pain
        </h2>
        <p class="section-lead">
          Direct answers grounded in biomedical literature for patients and clinicians.
        </p>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>
            <span>Can I return to sports if I have a herniated disc or wear on my MRI?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            <strong>Yes.</strong> Research shows that herniated discs and disc dehydration appear in 35% of pain-free adults over 40. The spine adapts to progressive load, so a structured graded exercise plan lets you rebuild athletic capacity safely.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>What is the difference between strict rest and active coping?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            Extended bed rest weakens supporting muscles, reduces disc nutrition, and heightens nervous system sensitivity. <strong>Active coping</strong> uses fixed time quotas (pacing) to retrain your nervous system so movement stops triggering a danger response.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>How does Clinical Psychoneuroimmunology (PNI) fit into physiotherapy?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            PNI studies the communication between nervous, immune, and endocrine systems. In clinical care, it helps assess sleep quality, circadian rhythm, chronic stress, and low-grade inflammation that shape tissue healing.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>Does learning pain neuroscience actually lower physical pain?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            Yes. Understanding pain physiology reduces fear-driven amygdala signaling and engages descending inhibitory pathways from the prefrontal cortex, releasing endogenous pain-modulating neurotransmitters.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Closing Editorial CTA -->
  <section class="closing-cta" aria-labelledby="closing-cta-heading">
    <div class="closing-cta-copy">
      <h2 id="closing-cta-heading" class="section-title" style="font-size: 1.65rem; margin-bottom: 8px;">
        Looking for clinical guidance on your pain?
      </h2>
      <p class="section-lead" style="font-size: 0.96rem;">
        Send a message with your questions or build your starting movement quota right now in the free coping guide.
      </p>
    </div>
    <div class="closing-cta-actions">
      <a href="/en/contact" class="btn-submit" style="width: auto;">
        Contact Cesar Santos
      </a>
      <a href="/en/coping-guide" class="btn-link">
        Open active coping guide &rarr;
      </a>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.myth-card');
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const isActive = card.classList.toggle('active');
          card.setAttribute('aria-expanded', String(isActive));
          const hint = card.querySelector('.myth-action-hint');
          if (hint) {
            hint.textContent = isActive
              ? (card.getAttribute('data-close-label') || 'Back')
              : (card.getAttribute('data-open-label') || 'See evidence →');
          }
        });
      });
    });
  </script>
</Layout>
