---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../utils/i18n';
import { getCollection } from 'astro:content';

const lang = 'es';
const t = useTranslations(lang);

// Get latest articles filtered by Spanish subdirectory
const allArticles = await getCollection('blog');
const esArticles = allArticles
  .filter(item => item.id.startsWith('es/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// JSON-LD ProfilePage & MedicalWebPage Schema
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Cesar Santos | Fisioterapia Integrativa, Neurociencia del Dolor y PNI",
  "description": "Fisioterapia basada en evidencia para el dolor persistente, hernia discal, ejercicios de actividad graduada y Psiconeuroinmunología Clínica (PNI).",
  "medicalSpecialty": "Physiotherapy",
  "mainEntity": {
    "@type": "Person",
    "name": "Cesar Santos",
    "givenName": "Cesar",
    "familyName": "Santos",
    "jobTitle": "Fisioterapeuta Especialista en Dolor Persistente y Salud Integrativa",
    "knowsAbout": [
      "Fisioterapia Musculoesquelética Basada en Evidencia",
      "Neurociencia del Dolor Persistente y Sensibilización Central",
      "Psiconeuroinmunología Clínica (PNI)",
      "Ejercicio Terapéutico Graduado y Pacing",
      "Abordaje de Hernias Discales y Dolor Lumbar"
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "Escuela Universitaria de Fisioterapia de la ONCE · Universidad Autónoma de Madrid (UAM)"
    }
  }
};

// JSON-LD FAQPage Schema for Google Rich Snippets & Search Intent
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Puedo hacer ejercicio si tengo una hernia discal o desgaste en la resonancia lumbar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, rotundamente. La evidencia científica demuestra que las hernias discales y las deshidrataciones son hallazgos habituales en el 35% de personas de 40 años sin dolor de espalda. Con un plan de fisioterapia integrativa y ejercicio graduado (pacing), puedes recuperar tu movimiento con total seguridad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué es el afrontamiento activo y el pacing en el dolor de espalda persistente?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El reposo prolongado debilita la musculatura e incrementa la sensibilidad del sistema nervioso. El afrontamiento activo sustituye el miedo al movimiento por un reentrenamiento progresivo controlado por cuotas de tiempo (pacing) para reeducar la alarma del dolor."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo ayuda la Psiconeuroinmunología Clínica (PNI) en la consulta de fisioterapia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La PNI analiza las relaciones entre el sistema nervioso, inmune y endocrino. Evalúa factores del estilo de vida (sueño, estrés crónico, nutrición e inflamación de bajo grado) que condicionan la hipersensibilidad del dolor muscular y articular."
      }
    },
    {
      "@type": "Question",
      "name": "¿Por qué educarse en neurociencia del dolor ayuda a reducir el dolor físico?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Entender que el dolor es un mecanismo de protección y no siempre un signo de daño en los tejidos desactiva la alarma del miedo en la amígdala cerebral y activa el control inhibitorio descendente del córtex prefrontal."
      }
    }
  ]
};

const schemaJson = JSON.stringify([schema, faqSchema]);
---

<Layout 
  title="Fisioterapia y Dolor Crónico | Cesar Santos · Salud Integrativa y Ejercicio" 
  description="Especialista en fisioterapia basada en la evidencia, neurociencia del dolor persistente, hernias discales, ejercicio terapéutico graduado y Psiconeuroinmunología Clínica (PNI)." 
  lang={lang} 
  canonicalPath="/" 
  schemaJson={schemaJson}
>
  <!-- Hero Section with Storytelling & Mission -->
  <section class="hero-section" aria-labelledby="manifesto-heading">
    <div class="hero-grid">
      <div>
        <span class="editorial-badge">Fisioterapia Basada en Evidencia · Salud Integrativa</span>
        <h1 id="manifesto-heading" class="hero-title">
          Fisioterapeuta en Dolor Persistente y Salud Integrativa
        </h1>
        <p class="hero-description">
          Si llevas meses lidiando con dolor de espalda, te han diagnosticado una hernia o sientes que el miedo al movimiento te impide hacer tu vida habitual, este espacio es para ti.
        </p>
        <p class="hero-description" style="font-size: 0.98rem; margin-top: -10px;">
          Soy <strong>Cesar Santos</strong>, fisioterapeuta graduado en la Escuela Universitaria de Fisioterapia de la ONCE (Universidad Autónoma de Madrid), ex-Capitán de Infantería de Montaña y Máster Universitario en Fisioterapia del Sistema Musculoesquelético con formación en PNI y Método Pilates. Mi trabajo consiste en evaluar qué mantiene activa la alarma de tu dolor, dosificar el ejercicio preciso y devolverte tu autonomía.
        </p>

        <!-- Rapid Access Buttons -->
        <div style="margin-top: 25px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
          <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="btn-submit" style="width: auto;">
            Guía de Afrontamiento del Dolor &rarr;
          </a>
          <a href={getLocalizedPath('/desmitificando-el-dolor', lang)} class="btn-link">
            Artículos y Evidencia Científica &rarr;
          </a>
        </div>
      </div>

      <!-- Hero Portrait Card (Unified Authority) -->
      <div class="hero-portrait-card">
        <img 
          src={`${import.meta.env.BASE_URL}images/cesar_santos_portrait.webp`} 
          alt="Cesar Santos - Fisioterapeuta en Salud Integrativa y Dolor Persistente" 
          class="hero-portrait-img" 
        />
        <div class="hero-portrait-caption">
          <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-color);">Cesar Santos</div>
          <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
            Fisioterapeuta · Escuela Univ. de Fisioterapia de la ONCE (UAM)
          </div>
          <div style="margin-top: 10px;">
            <a href={getLocalizedPath('/sobre-mi', lang)} class="btn-link" style="font-size: 0.82rem; padding: 4px 10px;">
              Conoce mi trayectoria completa &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Authority Trust Bar -->
    <div class="trust-bar" role="region" aria-label="Acreditaciones y Formación">
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Escuela Univ. de Fisioterapia de la ONCE (UAM)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Máster en Fisioterapia Musculoesquelética (OMT)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Psiconeuroinmunología Clínica (PNI)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Ejercicio Terapéutico y Método Pilates</span>
      </div>
    </div>
  </section>

  <!-- Common Conditions / What is Limiting You Section -->
  <section aria-labelledby="conditions-heading" style="margin: 80px 0 60px 0;">
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px auto;">
      <span class="editorial-badge">Motivos de Consulta Frecuentes</span>
      <h2 id="conditions-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 12px; color: var(--text-color);">
        ¿Qué molestia o dolor te está limitando?
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; margin: 0;">
        El dolor corporal no siempre significa daño irreversible. Identifica tu situación y descubre qué dice la evidencia científica actual.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      <!-- Condition 1: Lumbar -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">01 · Columna Lumbar</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Dolor Lumbar y Bloqueo de Espalda
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Rigidez matutina, pinchazos al agacharte o sensación de "quedarte clavado". La columna lumbar es una estructura biológica fuerte diseñada para moverse, no para inmovilizarse.
          </p>
        </div>
        <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Calcular ejercicio graduado &rarr;
        </a>
      </div>

      <!-- Condition 2: Sciatica -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">02 · Cadena Nerviosa</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Ciática y Dolor Irradiado a la Pierna
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Quemazón, hormigueo o calambres que descienden por el glúteo hacia la pierna o el pie. Evaluamos la sensibilidad del tejido nervioso y el origen funcional de la irritación.
          </p>
        </div>
        <a href={getLocalizedPath('/contacto', lang)} class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Consultar valoración clínica &rarr;
        </a>
      </div>

      <!-- Condition 3: Hernias -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">03 · Pruebas de Imagen</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Hernias Discales y Diagnósticos por Resonancia
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            ¿Te han dicho que tienes una hernia o desgaste y tienes miedo de cargar peso o hacer deporte? La ciencia demuestra que la imagen no equivale a una condena de dolor.
          </p>
        </div>
        <a href={getLocalizedPath('/desmitificando-el-dolor/resonancia-edad-no-dolor', lang)} class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Leer evidencia sobre hernias &rarr;
        </a>
      </div>

      <!-- Condition 4: Cervical -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">04 · Región Cervical</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Dolor Cervical y Tensión de Hombros
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Sobrecarga en trapecios, rigidez al girar el cuello y dolores de cabeza tensionales por horas de trabajo sentado y acumulación de estrés.
          </p>
        </div>
        <a href={getLocalizedPath('/desmitificando-el-dolor/equilibrio-estatuas-estabilidad-dinamica', lang)} class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Ver claves de movilidad cervical &rarr;
        </a>
      </div>

      <!-- Condition 5: Persistent Pain -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">05 · Sistema de Alarma</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Dolor Persistente que No Remite
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Molestias continuadas de más de 3 meses que no mejoran con reposo ni fármacos. Analizamos la hipersensibilidad del sistema nervioso y los factores de estilo de vida.
          </p>
        </div>
        <a href={getLocalizedPath('/desmitificando-el-dolor/freno-cerebro-control-prefrontal', lang)} class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Entender la alarma del dolor &rarr;
        </a>
      </div>

      <!-- Condition 6: Tendinopathies & Joint Overload -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">06 · Tejido y Tendón</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Tendinopatías, Hombro y Fascitis Plantar
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Dolor punzante al levantar el brazo (manguito rotador), en el tendón de Aquiles o al apoyar el talón por la mañana. Los tendones se adaptan con carga graduada, no con reposo absoluto.
          </p>
        </div>
        <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Estrategias de dosificación de carga &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- The 4 Pillars of Integrative Health Section -->
  <section aria-labelledby="pillars-heading" style="margin: 80px 0;">
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px auto;">
      <span class="editorial-badge">Metodología Clínica</span>
      <h2 id="pillars-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 12px; color: var(--text-color);">
        Los 4 Pilares de la Fisioterapia Integrativa y la PNI
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; margin: 0;">
        Si solo tratamos el punto exacto donde te duele, el dolor suele volver al poco tiempo. La <strong>Salud Integrativa</strong> y la <strong>Psiconeuroinmunología Clínica (PNI)</strong> miran el mapa completo: cómo se mueve tu cuerpo, cómo responde tu sistema nervioso, cómo descansas y qué factores de tu día a día mantienen la alarma del dolor encendida.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
      <!-- Pillar 1 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilar 01 · Terapia Manual</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Terapia Manual en Camilla
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Técnicas manuales precisas para aliviar el dolor agudo y desbloquear articulaciones o músculos contracturados. No es un masaje pasivo para que vuelvas eternamente, sino el punto de partida para que tu cuerpo gane alivio y empiece a moverse con confianza.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilar 02 · Ejercicio & Pilates</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Ejercicio Terapéutico y Pilates
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          El movimiento bien dosificado es la mejor medicina que existe. Diseñamos pautas de ejercicio sencillas y progresivas para fortalecer tu columna, mejorar tu control postural y demostrarle a tu cuerpo que es mucho más fuerte y capaz de lo que crees.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilar 03 · Estilo de Vida & PNI</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Psiconeuroinmunología Clínica (PNI)
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Tu dolor no vive aislado de tu vida diaria. Si duermes mal, sufres estrés continuo o tu alimentación favorece la inflamación silenciosa, el cuerpo amplifica cualquier molestia. Con la PNI ajustamos estos hábitos para que la mejoría se mantenga a largo plazo.
        </p>
      </div>

      <!-- Pillar 4 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilar 04 · Neurociencia del Dolor</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Educación en Ciencia del Dolor
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Entender lo que te pasa cambia físicamente cómo lo sientes. Desmontamos mitos sobre resonancias o "espaldas frágiles" para que pierdas el miedo a moverte. Cuando tu cerebro comprende que no hay peligro real, baja el volumen del dolor por sí mismo.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Myth Buster Section -->
  <section class="myth-section" aria-labelledby="myths-heading" style="margin: 80px 0;">
    <div style="text-align: center; max-width: 650px; margin: 0 auto 35px auto;">
      <span class="editorial-badge">Ciencia Frente a Creencias</span>
      <h2 id="myths-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 10px;">
        Desmitificador Rápido de Salud
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; margin: 0;">
        Haz clic en cualquier tarjeta para contrastar las creencias comunes con la realidad que demuestra la investigación clínica.
      </p>
    </div>

    <div class="myth-grid" role="region" aria-label="Mitos y Realidades del Dolor">
      <!-- Card 1: Hernias -->
      <div class="myth-card" role="button" aria-expanded="false" tabindex="0">
        <div>
          <span class="myth-label">Mito Común</span>
          <h3 class="myth-title">"Tengo una hernia discal en mi resonancia, por lo tanto mi columna está rota y dañada."</h3>
        </div>
        <div class="reality-content">
          <span class="reality-label">La Realidad Científica</span>
          <p style="margin: 0; font-size: 0.9rem;">
            <strong>El 35% de las personas mayores de 40 años tienen hernias discales sin sentir ningún dolor</strong> (Varun S. et al., 2025). La imagen refleja cambios normales por edad, como las arrugas en la piel, no un acta de discapacidad.
          </p>
        </div>
        <span class="myth-action-hint">Ver realidad &rarr;</span>
      </div>

      <!-- Card 2: Posture -->
      <div class="myth-card" role="button" aria-expanded="false" tabindex="0">
        <div>
          <span class="myth-label">Mito Común</span>
          <h3 class="myth-title">"Necesito encontrar la postura perfecta para sentarme o pararme y así evitar el dolor de espalda."</h3>
        </div>
        <div class="reality-content">
          <span class="reality-label">La Realidad Científica</span>
          <p style="margin: 0; font-size: 0.9rem;">
            <strong>No existe una postura única o perfecta.</strong> La ciencia demuestra que no hay relación causal entre posturas estáticas y el dolor. El cuerpo necesita movimiento y variabilidad; tu mejor postura es la siguiente.
          </p>
        </div>
        <span class="myth-action-hint">Ver realidad &rarr;</span>
      </div>

      <!-- Card 3: Pain vs Damage -->
      <div class="myth-card" role="button" aria-expanded="false" tabindex="0">
        <div>
          <span class="myth-label">Mito Común</span>
          <h3 class="myth-title">"Si una actividad física me duele, significa que me estoy haciendo daño en los tejidos."</h3>
        </div>
        <div class="reality-content">
          <span class="reality-label">La Realidad Científica</span>
          <p style="margin: 0; font-size: 0.9rem;">
            <strong>El dolor persistente es un sistema de alarma hipersensible.</strong> El dolor protege antes de que haya daño real. El movimiento graduado y adaptado entrena al cerebro para regular la sensibilidad.
          </p>
        </div>
        <span class="myth-action-hint">Ver realidad &rarr;</span>
      </div>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="articles-section" aria-labelledby="articles-heading" style="margin: 80px 0;">
    <div style="margin-bottom: 25px;">
      <span class="editorial-badge">Divulgación y Ciencia</span>
    </div>
    <div class="section-header" style="margin-bottom: 30px;">
      <h2 id="articles-heading" class="section-title" style="font-size: 1.9rem; margin: 0;">
        {t('latestPosts')}
      </h2>
      <a href="/desmitificando-el-dolor" class="btn-link">
        {t('viewAll')} &rarr;
      </a>
    </div>

    <!-- Articles Grid -->
    <div class="articles-grid">
      {esArticles.map((article) => {
        const cleanSlug = article.id.replace(/^es\//, '');
        return (
          <article class="article-card">
            <span class="article-category">
              {article.data.category}
            </span>
            <h3 class="article-title">
              <a href={getLocalizedPath(`/desmitificando-el-dolor/${cleanSlug}`, lang)}>
                {article.data.title}
              </a>
            </h3>
            <p class="article-description">
              {article.data.description}
            </p>
            <div class="article-footer">
              <span>{new Date(article.data.pubDate).toLocaleDateString('es-ES', { dateStyle: 'medium' })}</span>
              {article.data.doi && <span class="doi-badge">DOI: {article.data.doi.split('/')[1] || article.data.doi}</span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- FAQ Section with Schema.org FAQPage -->
  <section class="faq-section" aria-labelledby="faq-heading" style="margin: 80px 0; padding: 44px 32px; background: rgba(51, 99, 103, 0.03); border: 1px solid var(--border-color); border-radius: 16px;">
    <div style="text-align: center; max-width: 700px; margin: 0 auto 35px auto;">
      <span class="editorial-badge">Resolviendo Dudas Frecuentes</span>
      <h2 id="faq-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 12px; color: var(--text-color);">
        Preguntas Frecuentes sobre Salud y Dolor
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; margin: 0;">
        Respuestas directas basadas en la evidencia biomédica para pacientes y profesionales de la salud.
      </p>
    </div>

    <div class="faq-list" style="display: flex; flex-direction: column; gap: 15px; max-width: 800px; margin: 0 auto;">
      <!-- FAQ Item 1 -->
      <details class="faq-item">
        <summary style="font-weight: 700; font-size: 1.05rem; color: var(--text-color); list-style: none; display: flex; justify-content: space-between; align-items: center;">
          <span>¿Puedo volver a hacer deporte si tengo una hernia discal o desgaste en la resonancia?</span>
          <span style="color: var(--color-secondary); font-size: 1.3rem; margin-left: 10px;">+</span>
        </summary>
        <p style="margin-top: 14px; font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; border-top: 1px solid var(--border-color); padding-top: 12px;">
          <strong>Sí, rotundamente.</strong> La investigación demuestra que las hernias discales y deshidrataciones son hallazgos habituales en el 35% de las personas asintomáticas mayores de 40 años sin dolor. La columna es una estructura sólida y adaptable. Con una pauta de ejercicio graduado y reentrenamiento activo, puedes recuperar tu vida deportiva con total seguridad.
        </p>
      </details>

      <!-- FAQ Item 2 -->
      <details class="faq-item">
        <summary style="font-weight: 700; font-size: 1.05rem; color: var(--text-color); list-style: none; display: flex; justify-content: space-between; align-items: center;">
          <span>¿Qué diferencia hay entre el reposo absoluto y el afrontamiento activo?</span>
          <span style="color: var(--color-secondary); font-size: 1.3rem; margin-left: 10px;">+</span>
        </summary>
        <p style="margin-top: 14px; font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; border-top: 1px solid var(--border-color); padding-top: 12px;">
          El reposo prolongado debilita la musculatura, reduce la nutrición discal e incrementa la sensibilidad del sistema nervioso. El <strong>afrontamiento activo</strong> propone sustituir la inmovilidad por un movimiento controlado por cuotas de tiempo (Pacing), enseñándole a tu cerebro a desvincular el movimiento de la señal de peligro.
        </p>
      </details>

      <!-- FAQ Item 3 -->
      <details class="faq-item">
        <summary style="font-weight: 700; font-size: 1.05rem; color: var(--text-color); list-style: none; display: flex; justify-content: space-between; align-items: center;">
          <span>¿Cómo se integra la Psiconeuroinmunología Clínica (PNI) en la fisioterapia habitual?</span>
          <span style="color: var(--color-secondary); font-size: 1.3rem; margin-left: 10px;">+</span>
        </summary>
        <p style="margin-top: 14px; font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; border-top: 1px solid var(--border-color); padding-top: 12px;">
          La PNI estudia las interacciones entre el sistema nervioso, el sistema inmune y el sistema endocrino. En la consulta, nos ayuda a evaluar variables del estilo de vida (sueño, ritmos circadianos, estrés crónico e inflamación de bajo grado) que condicionan la capacidad de recuperación de los tejidos.
        </p>
      </details>

      <!-- FAQ Item 4 -->
      <details class="faq-item">
        <summary style="font-weight: 700; font-size: 1.05rem; color: var(--text-color); list-style: none; display: flex; justify-content: space-between; align-items: center;">
          <span>¿La educación en neurociencia del dolor realmente ayuda a reducir el dolor físico?</span>
          <span style="color: var(--color-secondary); font-size: 1.3rem; margin-left: 10px;">+</span>
        </summary>
        <p style="margin-top: 14px; font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; border-top: 1px solid var(--border-color); padding-top: 12px;">
          Sí. Aprender cómo funciona el dolor desactiva la alarma del miedo en la amígdala cerebral y estimula la vía moduladora descendente del dolor. Al fortalecer el control inhibitorio prefrontal, el cerebro libera neurotransmisores como endorfinas y serotonina que bloquean físicamente la señal dolorosa.
        </p>
      </details>
    </div>
  </section>

  <!-- Script to handle card interactions -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.myth-card');
      
      cards.forEach(card => {
        const toggleCard = () => {
          const isActive = card.classList.contains('active');
          card.classList.toggle('active');
          card.setAttribute('aria-expanded', !isActive);
        };

        card.addEventListener('click', toggleCard);
        
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleCard();
          }
        });
      });
    });
  </script>
</Layout>
