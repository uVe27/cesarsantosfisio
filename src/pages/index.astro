---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../utils/i18n';
import { getCollection } from 'astro:content';

const lang = 'es';
const t = useTranslations(lang);

const allArticles = await getCollection('blog');
const esArticles = allArticles
  .filter(item => item.id.startsWith('es/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Cesar Santos | Fisioterapia Integrativa, Neurociencia del Dolor y PNI",
  "description": "Fisioterapia basada en evidencia para el dolor persistente, hernia discal, ejercicios de actividad graduada y Psiconeuroinmunología Clínica (PNI).",
  "medicalSpecialty": "Physiotherapy",
  "mainEntity": {
    "@type": "Person",
    "name": "Cesar Santos",
    "givenName": "Cesar",
    "familyName": "Santos",
    "jobTitle": "Fisioterapeuta Especialista en Dolor Persistente y Salud Integrativa",
    "knowsAbout": [
      "Fisioterapia Musculoesquelética Basada en Evidencia",
      "Neurociencia del Dolor Persistente y Sensibilización Central",
      "Psiconeuroinmunología Clínica (PNI)",
      "Ejercicio Terapéutico Graduado y Pacing",
      "Abordaje de Hernias Discales y Dolor Lumbar"
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "Escuela Universitaria de Fisioterapia de la ONCE · Universidad Autónoma de Madrid (UAM)"
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Puedo hacer ejercicio si tengo una hernia discal o desgaste en la resonancia lumbar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, rotundamente. La evidencia científica demuestra que las hernias discales y las deshidrataciones son hallazgos habituales en el 35% de personas de 40 años sin dolor de espalda. Con un plan de fisioterapia integrativa y ejercicio graduado (pacing), puedes recuperar tu movimiento con total seguridad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué es el afrontamiento activo y el pacing en el dolor de espalda persistente?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El reposo prolongado debilita la musculatura e incrementa la sensibilidad del sistema nervioso. El afrontamiento activo sustituye el miedo al movimiento por un reentrenamiento progresivo controlado por cuotas de tiempo (pacing) para reeducar la alarma del dolor."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo ayuda la Psiconeuroinmunología Clínica (PNI) en la consulta de fisioterapia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La PNI analiza las relaciones entre el sistema nervioso, inmune y endocrino. Evalúa factores del estilo de vida (sueño, estrés crónico, nutrición e inflamación de bajo grado) que condicionan la hipersensibilidad del dolor muscular y articular."
      }
    },
    {
      "@type": "Question",
      "name": "¿Por qué educarse en neurociencia del dolor ayuda a reducir el dolor físico?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Entender que el dolor es un mecanismo de protección desactiva la alarma del miedo en la amígdala cerebral y activa el control inhibitorio descendente del córtex prefrontal."
      }
    }
  ]
};

const schemaJson = JSON.stringify([schema, faqSchema]);
---

<Layout
  title="Fisioterapia y Dolor Crónico | Cesar Santos · Salud Integrativa y Ejercicio"
  description="Especialista en fisioterapia basada en la evidencia, neurociencia del dolor persistente, hernias discales, ejercicio terapéutico graduado y Psiconeuroinmunología Clínica (PNI)."
  lang={lang}
  canonicalPath="/"
  schemaJson={schemaJson}
>
  <!-- Editorial Hero Section (No portrait duplication; patient-first clinical entry panel) -->
  <section class="hero-section" aria-labelledby="manifesto-heading">
    <div class="hero-grid">
      <div>
        <h1 id="manifesto-heading" class="hero-title">
          Fisioterapeuta en dolor persistente y salud integrativa
        </h1>
        <p class="hero-description">
          Si llevas meses lidiando con dolor de espalda, te preocupa el informe de una resonancia o el miedo a recaer limita tu vida diaria, trabajamos con fisioterapia basada en evidencia, ejercicio terapéutico graduado y Psiconeuroinmunología Clínica (PNI) para recuperar tu autonomía.
        </p>

        <div class="hero-actions">
          <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="btn-submit" style="width: auto;">
            Calcular pauta de afrontamiento &rarr;
          </a>
          <a href={getLocalizedPath('/desmitificando-el-dolor', lang)} class="btn-link">
            Leer evidencia científica
          </a>
        </div>

        <div class="hero-byline">
          <span><strong>Cesar Santos</strong> · Escuela Universitaria de Fisioterapia de la ONCE (UAM).</span>
          <a href={getLocalizedPath('/sobre-mi', lang)} class="inline-text-link">Conoce mi trayectoria &rarr;</a>
        </div>
      </div>

      <!-- Clinical Starting Point Panel -->
      <aside class="triage-panel" aria-labelledby="triage-heading">
        <h2 id="triage-heading" class="triage-panel-title">¿Por dónde empezar hoy?</h2>
        <p class="triage-panel-sub">Elige la situación que mejor describe tu caso actual:</p>

        <ul class="triage-list">
          <li class="triage-item">
            <a href={getLocalizedPath('/desmitificando-el-dolor/resonancia-edad-no-dolor', lang)} class="triage-link">
              <span>
                <span class="triage-link-title">Tengo una hernia o desgaste en la resonancia</span>
                <span class="triage-link-desc">Qué significan realmente estos hallazgos y por qué puedes volver a moverte.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          <li class="triage-item">
            <a href={getLocalizedPath('/desmitificando-el-dolor/freno-cerebro-control-prefrontal', lang)} class="triage-link">
              <span>
                <span class="triage-link-title">Llevo más de 3 meses con dolor persistente</span>
                <span class="triage-link-desc">Cómo funciona el sistema de alarma nervioso y el control inhibitorio cerebral.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          <li class="triage-item">
            <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="triage-link">
              <span>
                <span class="triage-link-title">Quiero retomar ejercicio sin provocar un brote</span>
                <span class="triage-link-desc">Calcula tu cuota segura de movimiento (pacing) y descarga tu pauta en PDF.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        </ul>

        <p class="triage-evidence-note">
          <strong>Dato clínico:</strong> el <span class="triage-stat-num">35 %</span> de las personas mayores de 40 años presentan hernias discales en resonancia sin ningún dolor (Varun S. et al., 2025).
        </p>
      </aside>
    </div>

    <!-- Authority Trust Bar -->
    <div class="trust-bar" role="region" aria-label="Acreditaciones y Formación">
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Escuela Universitaria de Fisioterapia de la ONCE (UAM)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Máster en Fisioterapia Musculoesquelética (OMT)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Psiconeuroinmunología Clínica (PNI)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Ejercicio Terapéutico y Método Pilates</span>
      </div>
    </div>
  </section>

  <!-- Common Conditions / Editorial 2-Column Index -->
  <section class="home-section" aria-labelledby="conditions-heading">
    <div class="section-intro">
      <h2 id="conditions-heading" class="section-title">
        ¿Qué molestia o dolor te está limitando?
      </h2>
      <p class="section-lead">
        Sentir dolor corporal rara vez equivale a un daño irreversible. Identifica tu caso y consulta qué demuestra la evidencia clínica actual.
      </p>
    </div>

    <div class="conditions-grid">
      <article class="condition-row">
        <div>
          <span class="condition-tag">Columna lumbar</span>
          <h3 class="condition-title">Dolor lumbar y bloqueo de espalda</h3>
          <p class="condition-desc">
            Rigidez al levantarte, pinchazos al agacharte o sensación de quedarte clavado. La columna lumbar es una estructura biológica fuerte diseñada para soportar carga y moverse.
          </p>
        </div>
        <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="editorial-link">
          Calcular ejercicio graduado &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Cadena nerviosa</span>
          <h3 class="condition-title">Ciática y dolor irradiado a la pierna</h3>
          <p class="condition-desc">
            Quemazón, hormigueo o calambres que descienden por el glúteo hacia la pierna o el pie. Evaluamos la sensibilidad del tejido nervioso y el origen funcional de la irritación.
          </p>
        </div>
        <a href={getLocalizedPath('/contacto', lang)} class="editorial-link">
          Consultar valoración clínica &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Pruebas de imagen</span>
          <h3 class="condition-title">Hernias discales y diagnósticos por resonancia</h3>
          <p class="condition-desc">
            Si te han diagnosticado una hernia o deshidratación y temes cargar peso o hacer deporte, la investigación clínica demuestra que la imagen radiológica es solo una foto parcial del problema.
          </p>
        </div>
        <a href={getLocalizedPath('/desmitificando-el-dolor/resonancia-edad-no-dolor', lang)} class="editorial-link">
          Leer evidencia sobre hernias &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Región cervical</span>
          <h3 class="condition-title">Dolor cervical y tensión de hombros</h3>
          <p class="condition-desc">
            Sobrecarga en trapecios, rigidez al girar el cuello y dolores de cabeza tensionales tras horas frente a la pantalla y acumulación de estrés diario.
          </p>
        </div>
        <a href={getLocalizedPath('/desmitificando-el-dolor/equilibrio-estatuas-estabilidad-dinamica', lang)} class="editorial-link">
          Ver claves de movilidad cervical &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Sistema de alarma</span>
          <h3 class="condition-title">Dolor persistente que se prolonga meses</h3>
          <p class="condition-desc">
            Molestias continuadas de más de 3 meses que persisten pese al reposo o los fármacos. Analizamos la sensibilización del sistema nervioso y los factores del estilo de vida que la mantienen.
          </p>
        </div>
        <a href={getLocalizedPath('/desmitificando-el-dolor/freno-cerebro-control-prefrontal', lang)} class="editorial-link">
          Entender la alarma del dolor &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Tejido y tendón</span>
          <h3 class="condition-title">Tendinopatías, hombro y fascitis plantar</h3>
          <p class="condition-desc">
            Dolor punzante al elevar el brazo (manguito rotador), en el tendón de Aquiles o al apoyar el talón por la mañana. Los tendones recuperan su capacidad mediante carga progresiva bien medida.
          </p>
        </div>
        <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="editorial-link">
          Estrategias de dosificación de carga &rarr;
        </a>
      </article>
    </div>
  </section>

  <!-- The 4 Pillars of Integrative Health (Full-Bleed Tonal Asymmetric Band) -->
  <section class="full-bleed-band" aria-labelledby="pillars-heading">
    <div class="band-inner">
      <div class="pillars-layout">
        <div class="pillars-intro-sticky">
          <h2 id="pillars-heading" class="section-title">
            Los 4 pilares de la fisioterapia integrativa y la PNI
          </h2>
          <p class="section-lead" style="margin-bottom: 24px;">
            Cuando el tratamiento se limita únicamente al punto exacto que duele, la molestia suele reaparecer al cabo de unas semanas. La <strong>Salud Integrativa</strong> y la <strong>Psiconeuroinmunología Clínica (PNI)</strong> analizan el conjunto completo: cómo se mueve tu cuerpo, cómo responde tu sistema nervioso, cómo descansas y qué hábitos diarios mantienen encendida la señal de alarma.
          </p>
          <a href={getLocalizedPath('/sobre-mi', lang)} class="editorial-link">
            Cómo trabajo y formación clínica &rarr;
          </a>
        </div>

        <div class="pillars-grid">
          <article class="pillar-card">
            <span class="card-number-tag">01 · Terapia Manual</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Terapia manual en camilla
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Técnicas manuales precisas para calmar el dolor agudo y liberar articulaciones o músculos tensos. Sirven como punto de partida para ganar alivio inmediato y empezar a moverte con seguridad.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">02 · Ejercicio y Pilates</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Ejercicio terapéutico y Pilates
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              El movimiento bien dosificado es la herramienta con mayor respaldo científico. Diseñamos pautas progresivas para fortalecer tu columna, mejorar el control motor y demostrarle a tu cuerpo toda su capacidad.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">03 · Estilo de Vida y PNI</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Psiconeuroinmunología Clínica (PNI)
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              El dolor convive con el resto de tu biología. Dormir mal, sostener estrés continuo o arrastrar inflamación silenciosa amplifica cualquier síntoma. Con la PNI ajustamos estos factores para consolidar la mejoría.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">04 · Neurociencia</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Educación en ciencia del dolor
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Comprender lo que ocurre en tus tejidos cambia físicamente la intensidad con la que lo percibes. Desmontamos mitos sobre resonancias o espaldas frágiles para que tu cerebro baje el volumen de la alarma.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Myth Buster Section (Semantic Buttons) -->
  <section class="home-section" aria-labelledby="myths-heading">
    <div class="section-intro">
      <h2 id="myths-heading" class="section-title">
        Creencias frecuentes frente a la evidencia clínica
      </h2>
      <p class="section-lead">
        Pulsa cualquier tarjeta para contrastar afirmaciones habituales sobre el dolor de espalda con lo que demuestran los estudios médicos.
      </p>
    </div>

    <div class="myth-grid" role="region" aria-label="Mitos y Realidades del Dolor">
      <button type="button" class="myth-card" aria-expanded="false" data-open-label="Ver evidencia →" data-close-label="Volver a la creencia">
        <span class="myth-front">
          <span class="myth-label">Creencia común</span>
          <span class="myth-title">“Tengo una hernia discal en mi resonancia, así que mi columna está dañada.”</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Evidencia clínica</span>
          <strong>El 35 % de las personas mayores de 40 años tienen hernias discales sin sentir dolor</strong> (Varun S. et al., 2025). La imagen refleja cambios normales de la edad, igual que las canas o las arrugas.
        </span>
        <span class="myth-action-hint">Ver evidencia &rarr;</span>
      </button>

      <button type="button" class="myth-card" aria-expanded="false" data-open-label="Ver evidencia →" data-close-label="Volver a la creencia">
        <span class="myth-front">
          <span class="myth-label">Creencia común</span>
          <span class="myth-title">“Necesito mantener una postura recta y perfecta para evitar el dolor de espalda.”</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Evidencia clínica</span>
          <strong>No existe una postura única ni perfecta.</strong> Las revisiones clínicas descartan una relación causal directa entre posturas estáticas y dolor. Tu mejor postura es la siguiente que adoptes.
        </span>
        <span class="myth-action-hint">Ver evidencia &rarr;</span>
      </button>

      <button type="button" class="myth-card" aria-expanded="false" data-open-label="Ver evidencia →" data-close-label="Volver a la creencia">
        <span class="myth-front">
          <span class="myth-label">Creencia común</span>
          <span class="myth-title">“Si una actividad física molesta, significa que estoy rompiendo los tejidos.”</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Evidencia clínica</span>
          <strong>El dolor persistente actúa como una alarma hipersensible.</strong> Avisa mucho antes de que exista daño estructural. El movimiento graduado reentrena al sistema nervioso para ajustar ese umbral.
        </span>
        <span class="myth-action-hint">Ver evidencia &rarr;</span>
      </button>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="home-section" style="padding-top: 20px;" aria-labelledby="articles-heading">
    <div class="section-header">
      <div>
        <h2 id="articles-heading" class="section-title" style="margin-bottom: 6px;">
          {t('latestPosts')}
        </h2>
        <p class="section-lead">Artículos con referencias primarias de PubMed traducidos a la práctica diaria.</p>
      </div>
      <a href={getLocalizedPath('/desmitificando-el-dolor', lang)} class="btn-link">
        {t('viewAll')} &rarr;
      </a>
    </div>

    <div class="articles-grid">
      {esArticles.map((article) => {
        const cleanSlug = article.id.replace(/^es\//, '');
        return (
          <article class="article-card">
            <span class="article-category">
              {article.data.category}
            </span>
            <h3 class="article-title">
              <a href={getLocalizedPath(`/desmitificando-el-dolor/${cleanSlug}`, lang)}>
                {article.data.title}
              </a>
            </h3>
            <p class="article-description">
              {article.data.description}
            </p>
            <div class="article-footer">
              <time datetime={article.data.pubDate.toISOString()}>
                {new Date(article.data.pubDate).toLocaleDateString('es-ES', { dateStyle: 'medium' })}
              </time>
              {article.data.doi && <span class="doi-badge">DOI: {article.data.doi.split('/')[1] || article.data.doi}</span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- FAQ Section (Editorial 2-Column Layout with FAQPage Schema) -->
  <section class="home-section" aria-labelledby="faq-heading">
    <div class="faq-layout">
      <div>
        <h2 id="faq-heading" class="section-title">
          Preguntas frecuentes sobre salud y dolor
        </h2>
        <p class="section-lead">
          Respuestas directas basadas en la evidencia biomédica para pacientes y profesionales sanitarios.
        </p>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>
            <span>¿Puedo volver a hacer deporte si tengo una hernia discal o desgaste en la resonancia?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            <strong>Sí, rotundamente.</strong> La investigación demuestra que las hernias discales y deshidrataciones aparecen en el 35 % de las personas mayores de 40 años sin dolor. La columna es una estructura sólida y adaptable. Con una pauta de ejercicio graduado y reentrenamiento activo, puedes recuperar tu vida deportiva con seguridad.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>¿Qué diferencia hay entre el reposo absoluto y el afrontamiento activo?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            El reposo prolongado debilita la musculatura, reduce la nutrición discal e incrementa la sensibilidad del sistema nervioso. El <strong>afrontamiento activo</strong> sustituye la inmovilidad por movimiento controlado por cuotas de tiempo (pacing), enseñando a tu cerebro a desvincular el movimiento de la señal de peligro.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>¿Cómo se integra la Psiconeuroinmunología Clínica (PNI) en la fisioterapia habitual?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            La PNI estudia las interacciones entre el sistema nervioso, el sistema inmune y el sistema endocrino. En consulta permite evaluar variables del estilo de vida (sueño, ritmos circadianos, estrés crónico e inflamación de bajo grado) que condicionan la recuperación de los tejidos.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>¿La educación en neurociencia del dolor realmente ayuda a reducir el dolor físico?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            Sí. Comprender cómo funciona el dolor desactiva la alarma del miedo en la amígdala cerebral y estimula la vía moduladora descendente. Al fortalecer el control inhibitorio prefrontal, el sistema nervioso libera neurotransmisores propios que reducen la señal dolorosa.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Closing Editorial CTA -->
  <section class="closing-cta" aria-labelledby="closing-cta-heading">
    <div class="closing-cta-copy">
      <h2 id="closing-cta-heading" class="section-title" style="font-size: 1.65rem; margin-bottom: 8px;">
        ¿Quieres orientación clínica sobre tu caso?
      </h2>
      <p class="section-lead" style="font-size: 0.96rem;">
        Cuéntame tu situación o empieza ahora mismo diseñando tu plan progresivo de movimiento en la guía gratuita.
      </p>
    </div>
    <div class="closing-cta-actions">
      <a href={getLocalizedPath('/contacto', lang)} class="btn-submit" style="width: auto;">
        Contactar con Cesar Santos
      </a>
      <a href={getLocalizedPath('/guia-afrontamiento', lang)} class="btn-link">
        Ir a la guía de afrontamiento &rarr;
      </a>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.myth-card');
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const isActive = card.classList.toggle('active');
          card.setAttribute('aria-expanded', String(isActive));
          const hint = card.querySelector('.myth-action-hint');
          if (hint) {
            hint.textContent = isActive
              ? (card.getAttribute('data-close-label') || 'Volver')
              : (card.getAttribute('data-open-label') || 'Ver evidencia →');
          }
        });
      });
    });
  </script>
</Layout>
