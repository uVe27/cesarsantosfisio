---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../utils/i18n';

const lang = 'fr';
const t = useTranslations(lang);

// Get latest articles filtered by French subdirectory
const allArticles = await getCollection('blog');
const frArticles = allArticles
  .filter(item => item.id.startsWith('fr/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// JSON-LD ProfilePage & MedicalWebPage Schema
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Cesar Santos | Kinésithérapie Intégrative, Neurosciences de la Douleur & PNI",
  "description": "Physiothérapie basée sur la science pour les douleurs persistantes, hernies discales, exercice progressif et Psychoneuroimmunologie Clinique (PNI).",
  "medicalSpecialty": "Physiotherapy",
  "mainEntity": {
    "@type": "Person",
    "name": "Cesar Santos",
    "givenName": "Cesar",
    "familyName": "Santos",
    "jobTitle": "Physiothérapeute Spécialiste en Douleur Persistante & Santé Intégrative",
    "knowsAbout": [
      "Physiothérapie Musculosquelettique Basée sur les Preuves",
      "Neurosciences de la Douleur Persistante & Sensibilisation Centrale",
      "Psychoneuroimmunologie Clinique (PNI)",
      "Exercice Thérapeutique Progressif (Pacing)",
      "Gestion de la Hernie Discale & Lombalgie"
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "École Universitaire de Physiothérapie de l'ONCE · Université Autonome de Madrid (UAM)"
    }
  }
};

const schemaJson = JSON.stringify(schema);
---

<Layout 
  title="Physiothérapie & Douleur Chronique | Cesar Santos · Santé Intégrative" 
  description="Kinésithérapie basée sur la science, neurosciences de la douleur persistante, hernie discale, exercice thérapeutique progressif et PNI." 
  lang={lang} 
  canonicalPath="/fr" 
  schemaJson={schemaJson}
>
  <!-- Hero Section with Storytelling & Mission -->
  <section class="hero-section" aria-labelledby="manifesto-heading">
    <div class="hero-grid">
      <div>
        <span class="editorial-badge">Physiothérapie Basée sur les Preuves · Santé Intégrative</span>
        <h1 id="manifesto-heading" class="hero-title">
          Physiothérapeute en Douleur Persistante et Santé Intégrative
        </h1>
        <p class="hero-description">
          Si vous souffrez de douleurs persistantes au dos, si l'on vous a diagnostiqué une hernie ou si la peur du mouvement vous empêche de vivre normalement, cet espace est fait pour vous.
        </p>
        <p class="hero-description" style="font-size: 0.98rem; margin-top: -10px;">
          Je suis <strong>Cesar Santos</strong>, physiothérapeute diplômé de l'École Universitaire de l'ONCE (UAM), ancien Capitaine d'Infanterie des Troupes de Montagne, avec un Master en Thérapie Manuelle Musculosquelettique et une formation en PNI et Méthode Pilates. Mon travail consiste à évaluer ce qui maintient votre alarme activée, doser l'exercice adéquat et vous rendre votre autonomie active.
        </p>

        <!-- Rapid Access Buttons -->
        <div style="margin-top: 25px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
          <a href="/fr/guide-adaptation" class="btn-submit" style="width: auto;">
            Guide d'Adaptation Active &rarr;
          </a>
          <a href="/fr/demystifier-la-douleur" class="btn-link">
            Articles & Preuves Scientifiques &rarr;
          </a>
        </div>
      </div>

      <!-- Hero Portrait Card (Unified Authority) -->
      <div class="hero-portrait-card">
        <img 
          src="/images/cesar_santos_portrait.webp" 
          alt="Cesar Santos - Physiothérapeute en Santé Intégrative et Douleur Persistante" 
          class="hero-portrait-img" 
        />
        <div class="hero-portrait-caption">
          <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-color);">Cesar Santos</div>
          <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
            Physiothérapeute Diplômé · École Univ. de Physiothérapie de l'ONCE (UAM)
          </div>
          <div style="margin-top: 10px;">
            <a href="/fr/a-propos" class="btn-link" style="font-size: 0.82rem; padding: 4px 10px;">
              Découvrir mon parcours complet &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Authority Trust Bar -->
    <div class="trust-bar" role="region" aria-label="Accréditations & Formation">
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>École Univ. de Physiothérapie de l'ONCE (UAM)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Master en Physiothérapie Musculosquelettique (OMT)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Psychoneuroimmunologie Clinique (PNI)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Exercice Thérapeutique & Méthode Pilates</span>
      </div>
    </div>
  </section>

  <!-- Common Conditions / What is Limiting You Section -->
  <section aria-labelledby="conditions-heading" style="margin: 80px 0 60px 0;">
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px auto;">
      <span class="editorial-badge">Motifs Fréquents de Consultation</span>
      <h2 id="conditions-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 12px; color: var(--text-color);">
        Quelle gêne ou douleur vous limite aujourd'hui ?
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; margin: 0;">
        La douleur corporelle ne signifie pas un dommage irréversible. Identifiez votre situation et découvrez ce que démontre la recherche clinique actuelle.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      <!-- Condition 1: Lumbar -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">01 · Colonne Lombaire</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Lumbago & Blocage Lombaire Aigu
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Raideur matinale, douleurs aiguës en se penchant ou sensation de blocage. La colonne lombaire est une structure solide conçue pour le mouvement, pas pour l'immobilité.
          </p>
        </div>
        <a href="/fr/guide-adaptation" class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Calculer l'exercice gradué &rarr;
        </a>
      </div>

      <!-- Condition 2: Sciatica -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">02 · Chaîne Nerveuse</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Sciatique & Douleur Irradiant dans la Jambe
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Brûlures, engourdissements ou décharges descendant du fessier vers la jambe et le pied. Nous évaluons la sensibilité neurodynamique et la cause fonctionnelle.
          </p>
        </div>
        <a href="/fr/contact" class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Demander une consultation clinique &rarr;
        </a>
      </div>

      <!-- Condition 3: Hernias -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">03 · Imagerie Médicale</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Hernies Discales & Résultats d'IRM
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            On vous a dit que vous aviez une usure ou une protrusion et vous avez peur de porter des charges ? La science prouve que l'IRM n'est pas une condamnation à vie.
          </p>
        </div>
        <a href="/fr/demystifier-la-douleur/irm-age-pas-douleur" class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Lire les preuves sur les hernies &rarr;
        </a>
      </div>

      <!-- Condition 4: Cervical -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">04 · Région Cervicale</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Douleur Cervicale & Tension aux Épaules
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Trapèzes contractés, raideur à la rotation du cou et maux de tête de tension liés aux longues heures de bureau et au stress accumulé.
          </p>
        </div>
        <a href="/fr/demystifier-la-douleur/equilibre-statues-stabilite-dynamique" class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Découvrir les clés de mobilité &rarr;
        </a>
      </div>

      <!-- Condition 5: Persistent Pain -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">05 · Système d'Alarme</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Douleur Persistante & Chronique
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Douleurs durant depuis plus de 3 mois sans amélioration par le repos ou les médicaments. Nous analysons l'hypersensibilité du système nerveux et les habitudes de vie.
          </p>
        </div>
        <a href="/fr/demystifier-la-douleur/frein-cerveau-controle-prefrontal" class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Comprendre l'alarme de la douleur &rarr;
        </a>
      </div>

      <!-- Condition 6: Tendinopathies & Joint Overload -->
      <div class="contact-card" style="padding: 26px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="card-number-tag">06 · Tissus & Tendons</span>
          <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
            Tendinopathies, Épaule & Fasciite Plantaire
          </h3>
          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px;">
            Douleur aiguë en levant le bras (coiffe des rotateurs), tendon d'Achille raide ou douleur au talon le matin. Les tendons s'adaptent avec une charge graduée, pas par le repos total.
          </p>
        </div>
        <a href="/fr/guide-adaptation" class="btn-link" style="font-weight: 700; font-size: 0.88rem;">
          Stratégies de dosage de charge &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- The 4 Pillars of Integrative Health Section -->
  <section aria-labelledby="pillars-heading" style="margin: 80px 0;">
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px auto;">
      <span class="editorial-badge">Méthodologie Clinique</span>
      <h2 id="pillars-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 12px; color: var(--text-color);">
        Les 4 Piliers de la Physiothérapie Intégrative et de la PNI
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; margin: 0;">
        Traiter uniquement la zone où vous avez mal conduit presque toujours à des rechutes. La <strong>Santé Intégrative</strong> et la <strong>Psychoneuroimmunologie Clinique (PNI)</strong> analysent l'ensemble : vos mouvements, la réactivité de votre système nerveux, votre sommeil et les habitudes de votre quotidien qui maintiennent l'alarme allumée.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
      <!-- Pillar 1 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilier 01 · Thérapie Manuelle</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Thérapie Manuelle en Cabinet
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Des techniques manuelles ciblées pour apaiser la douleur aiguë et libérer les blocages articulaires ou musculaires. Pas un soin passif sans fin, mais le point de départ pour redonner confiance à votre corps et recommencer à bouger sans appréhension.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilier 02 · Exercice & Pilates</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Exercice Thérapeutique & Pilates
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Le mouvement bien dosé est le meilleur médicament qui soit. Nous créons des exercices simples et progressifs pour renforcer votre dos, améliorer votre posture et vous prouver que votre corps est bien plus fort et capable que vous ne le pensiez.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilier 03 · Mode de Vie & PNI</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Psychoneuroimmunologie Clinique (PNI)
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Votre douleur ne vit pas isolée de votre quotidien. Un sommeil perturbé, un stress continu ou une alimentation favorisant l'inflammation rendent votre système nerveux hyper-réactif. Avec la PNI, nous équilibrons ces piliers pour des résultats durables.
        </p>
      </div>

      <!-- Pillar 4 -->
      <div class="pillar-card" style="padding: 26px;">
        <span class="card-number-tag">Pilier 04 · Sciences de la Douleur</span>
        <h3 style="font-size: 1.15rem; margin-bottom: 10px; color: var(--text-color); font-weight: 700;">
          Éducation en Sciences de la Douleur
        </h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
          Comprendre ce qu'il se passe change concrètement la façon dont vous le ressentez. Nous déconstruisons les fausses croyances sur les hernies ou le dos "fragile" pour effacer la peur du mouvement. Dès que votre cerveau comprend qu'il n'y a pas de danger réel, il baisse de lui-même le volume de la douleur.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Myth Buster Section -->
  <section class="myth-section" aria-labelledby="myths-heading" style="margin: 80px 0;">
    <div style="text-align: center; max-width: 650px; margin: 0 auto 35px auto;">
      <span class="editorial-badge">Sciences vs Croyances</span>
      <h2 id="myths-heading" class="section-title" style="font-size: 1.9rem; margin-bottom: 10px;">
        Démystificateur Rapide de Santé
      </h2>
      <p style="color: var(--text-muted); font-size: 0.98rem; margin: 0;">
        Cliquez sur n'importe quelle carte pour contraster les croyances communes avec les faits scientifiques démontrés par la recherche clinique.
      </p>
    </div>

    <div class="myth-grid" role="region" aria-label="Mythes et Réalités de la Douleur">
      <!-- Card 1: Hernias -->
      <div class="myth-card" role="button" aria-expanded="false" tabindex="0">
        <div>
          <span class="myth-label">Mythe Commun</span>
          <h3 class="myth-title">"J'ai une hernie discale sur mon IRM, donc ma colonne est cassée et endommagée."</h3>
        </div>
        <div class="reality-content">
          <span class="reality-label">La Réalité Scientifique</span>
          <p style="margin: 0; font-size: 0.9rem;">
            <strong>35 % des personnes de plus de 40 ans ont des hernies discales sans ressentir aucune douleur</strong> (Varun S. et al., 2025). L'imagerie reflète des changements normaux liés à l'âge, comme les rides sur la peau, pas un certificat d'invalidité.
          </p>
        </div>
        <span class="myth-action-hint">Voir réalité &rarr;</span>
      </div>

      <!-- Card 2: Posture -->
      <div class="myth-card" role="button" aria-expanded="false" tabindex="0">
        <div>
          <span class="myth-label">Mythe Commun</span>
          <h3 class="myth-title">"J'ai besoin de trouver la posture parfaite pour m'asseoir ou me tenir debout afin d'éviter le mal de dos."</h3>
        </div>
        <div class="reality-content">
          <span class="reality-label">La Réalité Scientifique</span>
          <p style="margin: 0; font-size: 0.9rem;">
            <strong>Il n'y a pas de posture unique ou parfaite.</strong> La science montre qu'il n'y a pas de lien de cause à effet entre les postures statiques et la douleur. Le corps a besoin de mouvement et de variabilité; votre meilleure posture est la suivante.
          </p>
        </div>
        <span class="myth-action-hint">Voir réalité &rarr;</span>
      </div>

      <!-- Card 3: Pain vs Damage -->
      <div class="myth-card" role="button" aria-expanded="false" tabindex="0">
        <div>
          <span class="myth-label">Mythe Commun</span>
          <h3 class="myth-title">"Si une activité physique me fait mal, cela signifie que j'endommage les tissus de mon corps."</h3>
        </div>
        <div class="reality-content">
          <span class="reality-label">La Réalité Scientifique</span>
          <p style="margin: 0; font-size: 0.9rem;">
            <strong>La douleur persistante est un système d'alarme hypersensible.</strong> La douleur protège avant qu'il n'y ait de véritables dommages. Le mouvement progressif et adapté entraîne le cerveau à réguler cette sensibilité.
          </p>
        </div>
        <span class="myth-action-hint">Voir réalité &rarr;</span>
      </div>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="articles-section" aria-labelledby="articles-heading" style="margin: 80px 0;">
    <div style="margin-bottom: 25px;">
      <span class="editorial-badge">Sciences & Vulgarisation</span>
    </div>
    <div class="section-header" style="margin-bottom: 30px;">
      <h2 id="articles-heading" class="section-title" style="font-size: 1.9rem; margin: 0;">
        {t('latestPosts')}
      </h2>
      <a href="/fr/demystifier-la-douleur" class="btn-link">
        {t('viewAll')} &rarr;
      </a>
    </div>

    <!-- Articles Grid -->
    <div class="articles-grid">
      {frArticles.map((article) => {
        const cleanSlug = article.id.replace(/^fr\//, '');
        return (
          <article class="article-card">
            <span class="article-category">
              {article.data.category}
            </span>
            <h3 class="article-title">
              <a href={`/fr/demystifier-la-douleur/${cleanSlug}`}>
                {article.data.title}
              </a>
            </h3>
            <p class="article-description">
              {article.data.description}
            </p>
            <div class="article-footer">
              <span>{new Date(article.data.pubDate).toLocaleDateString('fr-FR', { dateStyle: 'medium' })}</span>
              {article.data.doi && <span class="doi-badge">DOI: {article.data.doi.split('/')[1] || article.data.doi}</span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Script to handle card interactions -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.myth-card');
      
      cards.forEach(card => {
        const toggleCard = () => {
          const isActive = card.classList.contains('active');
          card.classList.toggle('active');
          card.setAttribute('aria-expanded', !isActive);
        };

        card.addEventListener('click', toggleCard);
        
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleCard();
          }
        });
      });
    });
  </script>
</Layout>
