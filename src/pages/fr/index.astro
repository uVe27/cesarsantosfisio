---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../utils/i18n';

const lang = 'fr';
const t = useTranslations(lang);

const allArticles = await getCollection('blog');
const frArticles = allArticles
  .filter(item => item.id.startsWith('fr/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "Cesar Santos | Kinésithérapie Intégrative, Neurosciences de la Douleur & PNI",
  "description": "Physiothérapie basée sur la science pour les douleurs persistantes, hernies discales, exercice progressif et Psychoneuroimmunologie Clinique (PNI).",
  "medicalSpecialty": "Physiotherapy",
  "mainEntity": {
    "@type": "Person",
    "name": "Cesar Santos",
    "givenName": "Cesar",
    "familyName": "Santos",
    "jobTitle": "Physiothérapeute Spécialiste en Douleur Persistante & Santé Intégrative",
    "knowsAbout": [
      "Physiothérapie Musculosquelettique Basée sur les Preuves",
      "Neurosciences de la Douleur Persistante & Sensibilisation Centrale",
      "Psychoneuroimmunologie Clinique (PNI)",
      "Exercice Thérapeutique Progressif (Pacing)",
      "Gestion de la Hernie Discale & Lombalgie"
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "École Universitaire de Physiothérapie de l'ONCE · Université Autonome de Madrid (UAM)"
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Puis-je faire du sport si j'ai une hernie discale ou une usure sur mon IRM ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui. La recherche clinique montre que les hernies discales et la déshydratation discale sont présentes chez 35 % des adultes de plus de 40 ans sans aucune douleur. Avec un plan progressif et encadré, vous pouvez reprendre le mouvement en sécurité."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle est la différence entre le repos strict et l'adaptation active (pacing) ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le repos prolongé affaiblit la musculature et augmente la sensibilité du système nerveux. L'adaptation active s'appuie sur des quotas de temps progressifs (pacing) afin que le cerveau dissocie le mouvement du signal de danger."
      }
    },
    {
      "@type": "Question",
      "name": "Comment la Psychoneuroimmunologie Clinique (PNI) s'intègre-t-elle en physiothérapie ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La PNI étudie les liens entre les systèmes nerveux, immunitaire et endocrinien. Elle aide à évaluer le sommeil, le stress chronique et l'inflammation de bas grade qui influencent la récupération tissulaire."
      }
    },
    {
      "@type": "Question",
      "name": "L'éducation aux neurosciences de la douleur réduit-elle vraiment la douleur physique ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui. Comprendre le mécanisme de la douleur diminue l'état d'alerte de l'amygdale cérébrale et active les voies inhibitrices descendantes du cortex préfrontal."
      }
    }
  ]
};

const schemaJson = JSON.stringify([schema, faqSchema]);
---

<Layout
  title="Physiothérapie & Douleur Chronique | Cesar Santos · Santé Intégrative"
  description="Kinésithérapie basée sur la science, neurosciences de la douleur persistante, hernie discale, exercice thérapeutique progressif et PNI."
  lang={lang}
  canonicalPath="/fr"
  schemaJson={schemaJson}
>
  <!-- Editorial Hero Section (No portrait duplication; patient-first clinical entry panel) -->
  <section class="hero-section" aria-labelledby="manifesto-heading">
    <div class="hero-grid">
      <div>
        <h1 id="manifesto-heading" class="hero-title">
          Physiothérapeute en douleur persistante et santé intégrative
        </h1>
        <p class="hero-description">
          Si vous souffrez du dos depuis des mois, si le compte rendu d'une IRM vous inquiète ou si la peur du mouvement freine votre quotidien, nous associons physiothérapie fondée sur les preuves, exercice gradué et Psychoneuroimmunologie Clinique (PNI) pour restaurer votre autonomie.
        </p>

        <div class="hero-actions">
          <a href={getLocalizedPath('/guide-adaptation', lang)} class="btn-submit" style="width: auto;">
            Calculer mon plan d'adaptation &rarr;
          </a>
          <a href={getLocalizedPath('/demystifier-la-douleur', lang)} class="btn-link">
            Lire les preuves scientifiques
          </a>
        </div>

        <div class="hero-byline">
          <span><strong>Cesar Santos</strong> · École Universitaire de Physiothérapie de l'ONCE (UAM).</span>
          <a href={getLocalizedPath('/a-propos', lang)} class="inline-text-link">Découvrir mon parcours &rarr;</a>
        </div>
      </div>

      <!-- Clinical Starting Point Panel -->
      <aside class="triage-panel" aria-labelledby="triage-heading">
        <h2 id="triage-heading" class="triage-panel-title">Par où commencer aujourd'hui ?</h2>
        <p class="triage-panel-sub">Choisissez la situation qui correspond le mieux à votre cas :</p>

        <ul class="triage-list">
          <li class="triage-item">
            <a href="/fr/demystifier-la-douleur/irm-age-pas-douleur" class="triage-link">
              <span>
                <span class="triage-link-title">J'ai une hernie ou une usure sur mon IRM</span>
                <span class="triage-link-desc">Ce que montrent ces images et pourquoi reprendre le mouvement reste sûr.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          <li class="triage-item">
            <a href="/fr/demystifier-la-douleur/frein-cerveau-controle-prefrontal" class="triage-link">
              <span>
                <span class="triage-link-title">Ma douleur dure depuis plus de 3 mois</span>
                <span class="triage-link-desc">Comprendre l'alarme nerveuse et le frein inhibiteur préfrontal.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
          <li class="triage-item">
            <a href="/fr/guide-adaptation" class="triage-link">
              <span>
                <span class="triage-link-title">Je veux reprendre l'exercice sans rechute</span>
                <span class="triage-link-desc">Calculez votre quota quotidien progressif grâce au pacing actif.</span>
              </span>
              <span class="triage-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        </ul>

        <p class="triage-evidence-note">
          <strong>Donnée clinique :</strong> <span class="triage-stat-num">35 %</span> des adultes de plus de 40 ans présentent des hernies discales à l'IRM sans aucune douleur (Varun S. et al., 2025).
        </p>
      </aside>
    </div>

    <!-- Authority Trust Bar -->
    <div class="trust-bar" role="region" aria-label="Accréditations & Formation">
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>École Universitaire de Physiothérapie de l'ONCE (UAM)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Master en Physiothérapie Musculosquelettique (OMT)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Psychoneuroimmunologie Clinique (PNI)</span>
      </div>
      <div class="trust-item">
        <span class="trust-item-bullet" aria-hidden="true"></span>
        <span>Exercice Thérapeutique & Méthode Pilates</span>
      </div>
    </div>
  </section>

  <!-- Common Conditions / Editorial 2-Column Index -->
  <section class="home-section" aria-labelledby="conditions-heading">
    <div class="section-intro">
      <h2 id="conditions-heading" class="section-title">
        Quelle gêne ou douleur vous limite aujourd'hui ?
      </h2>
      <p class="section-lead">
        Ressentir une douleur correspond rarement à une lésion irréversible. Repérez votre situation et consultez les données cliniques actuelles.
      </p>
    </div>

    <div class="conditions-grid">
      <article class="condition-row">
        <div>
          <span class="condition-tag">Colonne lombaire</span>
          <h3 class="condition-title">Lombalgie et blocage du bas du dos</h3>
          <p class="condition-desc">
            Raideur matinale, élancements en vous penchant ou sensation de blocage. La colonne lombaire est une structure solide conçue pour supporter des charges et bouger.
          </p>
        </div>
        <a href="/fr/guide-adaptation" class="editorial-link">
          Calculer l'exercice gradué &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Chaîne nerveuse</span>
          <h3 class="condition-title">Sciatique et douleur irradiant dans la jambe</h3>
          <p class="condition-desc">
            Brûlures, fourmillements ou décharges descendant du fessier vers la jambe et le pied. Nous évaluons la sensibilité neurodynamique et la cause fonctionnelle de l'irritation.
          </p>
        </div>
        <a href="/fr/contact" class="editorial-link">
          Demander une orientation clinique &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Imagerie médicale</span>
          <h3 class="condition-title">Hernies discales et résultats d'IRM</h3>
          <p class="condition-desc">
            Si l'on vous a parlé d'usure ou de protrusion et que vous craignez de porter des charges, la recherche montre que l'imagerie ne représente qu'une partie limitée du diagnostic.
          </p>
        </div>
        <a href="/fr/demystifier-la-douleur/irm-age-pas-douleur" class="editorial-link">
          Lire les preuves sur les hernies &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Région cervicale</span>
          <h3 class="condition-title">Douleur cervicale et tension aux épaules</h3>
          <p class="condition-desc">
            Trapèzes tendus, raideur à la rotation du cou et céphalées de tension liées aux longues heures de bureau et à la charge de stress.
          </p>
        </div>
        <a href="/fr/demystifier-la-douleur/equilibre-statues-stabilite-dynamique" class="editorial-link">
          Voir les clés de mobilité cervicale &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Système d'alarme</span>
          <h3 class="condition-title">Douleur persistante depuis plus de 3 mois</h3>
          <p class="condition-desc">
            Gênes prolongées qui résistent au repos ou aux antalgiques. Nous analysons l'hypersensibilité du système nerveux ainsi que le sommeil et les habitudes de vie.
          </p>
        </div>
        <a href="/fr/demystifier-la-douleur/frein-cerveau-controle-prefrontal" class="editorial-link">
          Comprendre l'alarme de la douleur &rarr;
        </a>
      </article>

      <article class="condition-row">
        <div>
          <span class="condition-tag">Tissus et tendons</span>
          <h3 class="condition-title">Tendinopathies, épaule et fasciite plantaire</h3>
          <p class="condition-desc">
            Douleur vive en levant le bras (coiffe des rotateurs), raideur du tendon d'Achille ou douleur au talon au réveil. Les tendons s'adaptent grâce à une mise en charge progressive.
          </p>
        </div>
        <a href="/fr/guide-adaptation" class="editorial-link">
          Stratégies de dosage de charge &rarr;
        </a>
      </article>
    </div>
  </section>

  <!-- The 4 Pillars of Integrative Health (Full-Bleed Tonal Asymmetric Band) -->
  <section class="full-bleed-band" aria-labelledby="pillars-heading">
    <div class="band-inner">
      <div class="pillars-layout">
        <div class="pillars-intro-sticky">
          <h2 id="pillars-heading" class="section-title">
            Les 4 piliers de la physiothérapie intégrative et de la PNI
          </h2>
          <p class="section-lead" style="margin-bottom: 24px;">
            Traiter uniquement le point douloureux conduit fréquemment à des rechutes. La <strong>Santé Intégrative</strong> et la <strong>Psychoneuroimmunologie Clinique (PNI)</strong> analysent l'ensemble : vos mouvements, la réactivité de votre système nerveux, votre sommeil et les facteurs quotidiens qui entretiennent l'alarme.
          </p>
          <a href="/fr/a-propos" class="editorial-link">
            Parcours et méthode clinique &rarr;
          </a>
        </div>

        <div class="pillars-grid">
          <article class="pillar-card">
            <span class="card-number-tag">01 · Thérapie Manuelle</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Thérapie manuelle en cabinet
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Des techniques manuelles ciblées pour apaiser la douleur aiguë et lever les raideurs articulaires ou musculaires. Elles offrent un point de départ clair pour recommencer à bouger avec assurance.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">02 · Exercice & Pilates</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Exercice thérapeutique et Pilates
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Le mouvement dosé avec précision possède le meilleur niveau de preuve clinique. Nous élaborons des exercices progressifs pour renforcer le dos, affiner le contrôle moteur et retrouver confiance dans votre corps.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">03 · Mode de Vie & PNI</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Psychoneuroimmunologie Clinique (PNI)
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              La douleur interagit en continu avec votre biologie. Un sommeil fragmenté, un stress prolongé ou une inflammation silencieuse abaissent votre seuil de tolérance. La PNI aide à rééquilibrer ces leviers.
            </p>
          </article>

          <article class="pillar-card">
            <span class="card-number-tag">04 · Neurosciences</span>
            <h3 style="font-size: 1.18rem; margin-bottom: 10px;">
              Éducation en sciences de la douleur
            </h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.62; margin: 0;">
              Comprendre ce qui se passe dans votre organisme modifie concrètement la perception des symptômes. Déconstruire les idées reçues autour de l'IRM aide le cerveau à réduire les signaux d'alerte excessifs.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Myth Buster Section (Semantic Buttons) -->
  <section class="home-section" aria-labelledby="myths-heading">
    <div class="section-intro">
      <h2 id="myths-heading" class="section-title">
        Idées reçues face aux données cliniques
      </h2>
      <p class="section-lead">
        Cliquez sur chaque carte pour comparer les croyances fréquentes sur le mal de dos avec les résultats publiés en recherche médicale.
      </p>
    </div>

    <div class="myth-grid" role="region" aria-label="Mythes et Réalités de la Douleur">
      <button type="button" class="myth-card" aria-expanded="false" data-open-label="Voir les preuves →" data-close-label="Revenir à la croyance">
        <span class="myth-front">
          <span class="myth-label">Croyance fréquente</span>
          <span class="myth-title">« J'ai une hernie discale sur mon IRM, donc ma colonne est abîmée. »</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Données cliniques</span>
          <strong>35 % des personnes de plus de 40 ans présentent des hernies discales sans douleur</strong> (Varun S. et al., 2025). L'image reflète des changements normaux liés à l'âge, comparables aux rides de la peau.
        </span>
        <span class="myth-action-hint">Voir les preuves &rarr;</span>
      </button>

      <button type="button" class="myth-card" aria-expanded="false" data-open-label="Voir les preuves →" data-close-label="Revenir à la croyance">
        <span class="myth-front">
          <span class="myth-label">Croyance fréquente</span>
          <span class="myth-title">« Je dois garder une posture droite parfaite pour éviter le mal de dos. »</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Données cliniques</span>
          <strong>Aucune posture unique parfaite n'existe.</strong> Les revues scientifiques écartent un lien causal direct entre posture statique et douleur. Varier régulièrement reste la règle : votre meilleure posture est la suivante.
        </span>
        <span class="myth-action-hint">Voir les preuves &rarr;</span>
      </button>

      <button type="button" class="myth-card" aria-expanded="false" data-open-label="Voir les preuves →" data-close-label="Revenir à la croyance">
        <span class="myth-front">
          <span class="myth-label">Croyance fréquente</span>
          <span class="myth-title">« Si un mouvement fait mal, cela veut dire que j'endommage mes tissus. »</span>
        </span>
        <span class="reality-content">
          <span class="reality-label">Données cliniques</span>
          <strong>La douleur persistante agit comme une alarme hypersensible.</strong> Elle se déclenche bien avant toute lésion réelle. Le mouvement progressif rééduque le système nerveux à ajuster ce seuil.
        </span>
        <span class="myth-action-hint">Voir les preuves &rarr;</span>
      </button>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="home-section" style="padding-top: 20px;" aria-labelledby="articles-heading">
    <div class="section-header">
      <div>
        <h2 id="articles-heading" class="section-title" style="margin-bottom: 6px;">
          {t('latestPosts')}
        </h2>
        <p class="section-lead">Synthèses d'études PubMed traduites en repères pratiques.</p>
      </div>
      <a href="/fr/demystifier-la-douleur" class="btn-link">
        {t('viewAll')} &rarr;
      </a>
    </div>

    <div class="articles-grid">
      {frArticles.map((article) => {
        const cleanSlug = article.id.replace(/^fr\//, '');
        return (
          <article class="article-card">
            <span class="article-category">
              {article.data.category}
            </span>
            <h3 class="article-title">
              <a href={`/fr/demystifier-la-douleur/${cleanSlug}`}>
                {article.data.title}
              </a>
            </h3>
            <p class="article-description">
              {article.data.description}
            </p>
            <div class="article-footer">
              <time datetime={article.data.pubDate.toISOString()}>
                {new Date(article.data.pubDate).toLocaleDateString('fr-FR', { dateStyle: 'medium' })}
              </time>
              {article.data.doi && <span class="doi-badge">DOI: {article.data.doi.split('/')[1] || article.data.doi}</span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- FAQ Section (Editorial 2-Column Layout with FAQPage Schema) -->
  <section class="home-section" aria-labelledby="faq-heading">
    <div class="faq-layout">
      <div>
        <h2 id="faq-heading" class="section-title">
          Questions fréquentes sur la santé et la douleur
        </h2>
        <p class="section-lead">
          Réponses directes appuyées sur la littérature biomédicale pour les patients et les soignants.
        </p>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>
            <span>Puis-je reprendre le sport avec une hernie discale ou une usure à l'IRM ?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            <strong>Oui.</strong> Les études montrent que 35 % des adultes de plus de 40 ans sans douleur présentent des hernies ou déshydratations discales. La colonne s'adapte aux contraintes progressives : un programme dosé permet de reprendre l'activité physique en sécurité.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>Quelle est la différence entre le repos complet et l'adaptation active ?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            Le repos prolongé diminue la force musculaire, réduit la nutrition discale et accentue la sensibilité nerveuse. L'<strong>adaptation active</strong> repose sur des quotas de temps (pacing) qui apprennent au système nerveux à dissocier mouvement et danger.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>Comment la Psychoneuroimmunologie Clinique (PNI) complète-t-elle la physiothérapie ?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            La PNI étudie les échanges entre les systèmes nerveux, immunitaire et endocrinien. Elle aide à repérer les variables d'hygiène de vie (sommeil, rythme circadien, stress chronique, inflammation de bas grade) qui modulent la récupération des tissus.
          </p>
        </details>

        <details class="faq-item">
          <summary>
            <span>Comprendre les neurosciences de la douleur aide-t-il vraiment à avoir moins mal ?</span>
            <span class="faq-toggle-icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq-answer">
            Oui. Comprendre le fonctionnement de la douleur calme la réactivité de l'amygdale et active les voies inhibitrices descendantes du cortex préfrontal, qui libèrent des médiateurs endogènes capables de moduler le signal douloureux.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Closing Editorial CTA -->
  <section class="closing-cta" aria-labelledby="closing-cta-heading">
    <div class="closing-cta-copy">
      <h2 id="closing-cta-heading" class="section-title" style="font-size: 1.65rem; margin-bottom: 8px;">
        Besoin d'une orientation clinique sur votre situation ?
      </h2>
      <p class="section-lead" style="font-size: 0.96rem;">
        Écrivez-moi vos questions ou calculez dès maintenant votre quota de reprise dans le guide gratuit d'adaptation active.
      </p>
    </div>
    <div class="closing-cta-actions">
      <a href="/fr/contact" class="btn-submit" style="width: auto;">
        Contacter Cesar Santos
      </a>
      <a href="/fr/guide-adaptation" class="btn-link">
        Ouvrir le guide d'adaptation &rarr;
      </a>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('.myth-card');
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const isActive = card.classList.toggle('active');
          card.setAttribute('aria-expanded', String(isActive));
          const hint = card.querySelector('.myth-action-hint');
          if (hint) {
            hint.textContent = isActive
              ? (card.getAttribute('data-close-label') || 'Retour')
              : (card.getAttribute('data-open-label') || 'Voir les preuves →');
          }
        });
      });
    });
  </script>
</Layout>
