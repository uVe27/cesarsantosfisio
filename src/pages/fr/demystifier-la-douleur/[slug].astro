---
import Layout from '../../../layouts/Layout.astro';
import SocialShare from '../../../components/SocialShare.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const allArticles = await getCollection('blog');
  const frArticles = allArticles.filter(item => item.id.startsWith('fr/'));
  
  return frArticles.map((article) => {
    const slug = article.id.replace(/^fr\//, '');
    return {
      params: { slug },
      props: { article }
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);

const lang = 'fr';
const t = useTranslations(lang);

// Constructing comprehensive MedicalWebPage + TechArticle JSON-LD schema for Healthcare E-E-A-T
const articleUrl = `https://cesarsantos.me/fr/demystifier-la-douleur/${Astro.params.slug}`;
const imageUrl = article.data.image ? `https://cesarsantos.me${article.data.image}` : 'https://cesarsantos.me/images/og-default.jpg';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalWebPage", "TechArticle", "BlogPosting"],
      "@id": `${articleUrl}#article`,
      "url": articleUrl,
      "headline": article.data.title,
      "description": article.data.description,
      "datePublished": article.data.pubDate.toISOString(),
      "dateModified": article.data.pubDate.toISOString(),
      "inLanguage": "fr-FR",
      "image": {
        "@type": "ImageObject",
        "url": imageUrl,
        "width": 1200,
        "height": 630
      },
      "author": {
        "@type": "Person",
        "@id": "https://cesarsantos.me/fr/a-propos#person",
        "name": article.data.author || "Cesar Santos",
        "jobTitle": "Physiothérapeute",
        "url": "https://cesarsantos.me/fr/a-propos",
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "École Universitaire de Physiothérapie de l'ONCE · Université Autonome de Madrid",
          "sameAs": "https://www.uam.es"
        },
        "knowsAbout": [
          "Physiothérapie",
          "Psychoneuroimmunologie Clinique",
          "Neurosciences de la Douleur",
          "Exercice Thérapeutique",
          "Thérapie Manuelle Orthopédique"
        ],
        "sameAs": [
          "https://cesarsantos.me/fr/a-propos",
          "https://es.linkedin.com/in/cesar-santos-fisio"
        ]
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://cesarsantos.me/#organization",
        "name": "Cesar Santos · Physiothérapie Intégrative & Santé",
        "url": "https://cesarsantos.me",
        "logo": {
          "@type": "ImageObject",
          "url": "https://cesarsantos.me/LOGO/logo_dark.png"
        }
      },
      "genre": "Vulgarisation Scientifique en Santé",
      "audience": {
        "@type": "MedicalAudience",
        "audienceType": "Patients et Professionnels de Santé"
      },
      "about": [
        {
          "@type": "MedicalSpecialty",
          "name": "Physiotherapy"
        },
        {
          "@type": "MedicalCondition",
          "name": "Douleur Persistante et Santé de la Colonne"
        }
      ],
      ...(article.data.doi && { "identifier": article.data.doi }),
      ...(article.data.pubmedUrl && { "sameAs": article.data.pubmedUrl })
    }
  ]
};

const schemaJson = JSON.stringify(schema);
---

<Layout 
  title={article.data.title} 
  description={article.data.description} 
  lang={lang} 
  canonicalPath={`/fr/demystifier-la-douleur/${Astro.params.slug}`}
  schemaJson={schemaJson}
  ogType="article"
  ogImage={article.data.image || '/images/og-default.jpg'}
>
  <article class="article-detail">
    <!-- Meta details header -->
    <header class="article-detail-header">
      <span class="article-category">
        {article.data.category}
      </span>
      <h1 class="hero-title" style="text-transform: none; font-size: 2.2rem; line-height: 1.3; margin-bottom: 20px;">
        {article.data.title}
      </h1>
      
      <div class="article-detail-meta">
        <time datetime={article.data.pubDate.toISOString()}>
          {new Date(article.data.pubDate).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
        </time>
        <span>·</span>
        <span>{t('authorLabel')}: {article.data.author}</span>
      </div>

      <!-- Evidence / Authority References -->
      {(article.data.doi || article.data.pubmedUrl) && (
        <div class="authority-references" style="margin-top: 25px;">
          {article.data.doi && (
            <div>
              <strong style="color: var(--text-color);">{t('doiLabel')}:</strong>{' '}
              <a href={`https://doi.org/${article.data.doi}`} target="_blank" rel="noopener noreferrer" style="font-family: monospace;">
                {article.data.doi}
              </a>
            </div>
          )}
          {article.data.pubmedUrl && (
            <a 
              href={article.data.pubmedUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="pubmed-btn"
            >
              {t('pubmedLabel')}
            </a>
          )}
        </div>
      )}

      <!-- Social Share Bar (Top) -->
      <SocialShare title={article.data.title} lang={lang} />
    </header>

    <!-- Main Content rendered from markdown -->
    <div class="prose">
      <Content />
    </div>

    <!-- Social Share Bar (Bottom) -->
    <div style="margin-top: 40px; border-top: 1px solid var(--border-color); padding-top: 20px;">
      <SocialShare title={article.data.title} lang={lang} />
    </div>

    <!-- Related Articles Section -->
    <RelatedArticles currentId={article.id} category={article.data.category} tags={article.data.tags} lang={lang} />

    <!-- Back Button -->
    <footer class="back-btn-wrapper">
      <a href="/fr/demystifier-la-douleur" class="btn-link">
        &larr; Retour à la liste
      </a>
    </footer>
  </article>
</Layout>
