---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../utils/i18n';

const lang = 'fr';
const t = useTranslations(lang);
---

<Layout 
  title="Contact & Collaborations" 
  description="Contactez Cesar Santos pour des conférences, des questions de santé ou des collaborations de communication scientifique." 
  lang={lang} 
  canonicalPath="/fr/contact"
>
  <div class="article-detail" style="max-width: 1000px;">
    <span class="hero-subtitle">Contact Direct et Orientation</span>
    <h1 class="hero-title" style="margin-bottom: 30px;">
      Contacter Cesar Santos · Physiothérapeute
    </h1>

    <div class="contact-layout">
      <!-- Media Kit Info -->
      <section aria-labelledby="collaboration-heading">
        <h2 id="collaboration-heading" style="font-size: 1.3rem; margin-bottom: 15px;">
          On discute ?
        </h2>
        <p style="color: var(--text-muted); margin-bottom: 25px;">
          Je suis disponible pour répondre à vos questions sur la douleur, collaborer avec les médias, participer à des podcasts de santé ou animer des conférences de vulgarisation accessibles pour le grand public.
        </p>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; margin-bottom: 30px;" role="list">
          <li style="display: flex; align-items: start; gap: 10px; font-size: 0.95rem;">
            <span style="color: var(--color-secondary); font-weight: bold;" aria-hidden="true">&#10003;</span>
            <span>Conférences de vulgarisation sur la douleur et les habitudes de vie pour les entreprises ou associations.</span>
          </li>
          <li style="display: flex; align-items: start; gap: 10px; font-size: 0.95rem;">
            <span style="color: var(--color-secondary); font-weight: bold;" aria-hidden="true">&#10003;</span>
            <span>Interviews pour la radio, les podcasts, la télévision et la presse écrite.</span>
          </li>
          <li style="display: flex; align-items: start; gap: 10px; font-size: 0.95rem;">
            <span style="color: var(--color-secondary); font-weight: bold;" aria-hidden="true">&#10003;</span>
            <span>Rédaction et révision de contenus d'information éthiques et accessibles sur la santé.</span>
          </li>
        </ul>
      </section>

      <!-- Contact Form / Action Box -->
      <section aria-labelledby="form-heading" class="contact-card">
        <h2 id="form-heading" style="font-size: 1.3rem; margin-bottom: 10px;">
          Envoyer un message
        </h2>
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 25px;">
          Tous les champs sont obligatoires. Vous recevrez une réponse sous 48 heures ouvrées.
        </p>

        <form action="https://formsubmit.co/masthorth_csc@hotmail.com" method="POST">
          <input type="hidden" name="_subject" value="Nouveau message du site Cesar Santos (FR)" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <div class="form-group">
            <label for="name" class="form-label">
              Nom complet
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="form-control"
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">
              Adresse e-mail
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="form-control"
            />
          </div>

          <div class="form-group">
            <label for="message" class="form-label">
              Message / Proposition de collaboration
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required 
              class="form-control"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="btn-submit"
          >
            Envoyer la demande
          </button>
        </form>
      </section>
    </div>
  </div>
</Layout>
