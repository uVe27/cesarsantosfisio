---
import Layout from '../../layouts/Layout.astro';
import SocialShare from '../../components/SocialShare.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../utils/i18n';

export async function getStaticPaths() {
  const allArticles = await getCollection('blog');
  const esArticles = allArticles.filter(item => item.id.startsWith('es/'));
  
  return esArticles.map((article) => {
    const slug = article.id.replace(/^es\//, '');
    return {
      params: { slug },
      props: { article }
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);

const lang = 'es';
const t = useTranslations(lang);

// Constructing precise JSON-LD TechArticle schema for EEAT
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": article.data.title,
  "description": article.data.description,
  "datePublished": article.data.pubDate.toISOString(),
  "dateModified": article.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": article.data.author,
    "jobTitle": "Fisioterapeuta",
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "Escuela Universitaria de Fisioterapia ONCE - Universidad Autónoma de Madrid"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cesar Santos Fisioterapia y Salud"
  },
  "genre": "Divulgación Científica",
  "about": {
    "@type": "MedicalSpecialty",
    "name": "Physical Therapy"
  },
  ...(article.data.doi && { "identifier": article.data.doi }),
  ...(article.data.pubmedUrl && { "sameAs": article.data.pubmedUrl })
};

const schemaJson = JSON.stringify(schema);
---

<Layout 
  title={article.data.title} 
  description={article.data.description} 
  lang={lang} 
  canonicalPath={`/desmitificando-el-dolor/${Astro.params.slug}`}
  schemaJson={schemaJson}
  ogType="article"
>
  <article class="article-detail">
    <!-- Meta details header -->
    <header class="article-detail-header">
      <span class="article-category">
        {article.data.category}
      </span>
      <h1 class="hero-title" style="text-transform: none; font-size: 2.2rem; line-height: 1.3; margin-bottom: 20px;">
        {article.data.title}
      </h1>
      
      <div class="article-detail-meta">
        <time datetime={article.data.pubDate.toISOString()}>
          {new Date(article.data.pubDate).toLocaleDateString('es-ES', { dateStyle: 'long' })}
        </time>
        <span>·</span>
        <span>{t('authorLabel')}: {article.data.author}</span>
      </div>

      <!-- Evidence / Authority References -->
      {(article.data.doi || article.data.pubmedUrl) && (
        <div class="authority-references" style="margin-top: 25px; padding: 15px; background: rgba(51, 99, 103, 0.05); border-left: 3px solid var(--color-secondary); border-radius: 6px;">
          <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--color-secondary); letter-spacing: 0.05em; margin-bottom: 6px;">
            Referencia Bibliográfica
          </div>
          {article.data.doi && (
            <div style="font-size: 0.85rem; margin-bottom: 8px;">
              <strong>{t('doiLabel')}:</strong>{' '}
              <a href={`https://doi.org/${article.data.doi}`} target="_blank" rel="noopener noreferrer" style="font-family: monospace; text-decoration: underline;">
                https://doi.org/{article.data.doi}
              </a>
            </div>
          )}
          {article.data.pubmedUrl && (
            <a 
              href={article.data.pubmedUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="pubmed-btn"
              style="display: inline-block; margin-top: 5px;"
            >
              {t('pubmedLabel')} (Medline/PubMed) &rarr;
            </a>
          )}
        </div>
      )}

      <!-- Social Share Bar (Top) -->
      <SocialShare title={article.data.title} lang={lang} />
    </header>

    <!-- Main Content rendered from markdown -->
    <div class="prose">
      <Content />
    </div>

    <!-- Social Share Bar (Bottom) -->
    <div style="margin-top: 40px; border-top: 1px solid var(--border-color); padding-top: 20px;">
      <SocialShare title={article.data.title} lang={lang} />
    </div>

    <!-- Related Articles Section -->
    <RelatedArticles currentId={article.id} category={article.data.category} tags={article.data.tags} lang={lang} />

    <!-- Back Button -->
    <footer class="back-btn-wrapper">
      <a href={getLocalizedPath('/desmitificando-el-dolor', lang)} class="btn-link">
        &larr; Volver al listado
      </a>
    </footer>
  </article>
</Layout>
