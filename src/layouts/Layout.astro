---
import { useTranslations, getLocalizedPath, getWithBase, type Locale } from '../utils/i18n';
import CookieConsent from '../components/CookieConsent.astro';
import BrandLogo from '../components/BrandLogo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  canonicalPath?: string;
  schemaJson?: string;
  ogType?: 'website' | 'article';
}

const { 
  title, 
  description, 
  lang = 'es', 
  canonicalPath = '', 
  schemaJson, 
  ogType = 'website' 
} = Astro.props;

const t = useTranslations(lang);

const siteUrl = 'https://cesarsantos.me';
const canonicalUrl = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : '/' + canonicalPath}`;
const ogImageUrl = `${siteUrl}/images/og-default.webp`; // Fallback default OG image

// Lang switcher paths helper
const getLocalizedPathForSwitch = (targetLang: Locale) => {
  let rawPath = Astro.url.pathname;
  const base = import.meta.env.BASE_URL.endsWith('/') 
    ? import.meta.env.BASE_URL.slice(0, -1) 
    : import.meta.env.BASE_URL;
  if (base && rawPath.startsWith(base)) {
    rawPath = rawPath.slice(base.length);
  }
  return getLocalizedPath(rawPath, targetLang);
};

const esPath = `${siteUrl}${getLocalizedPathForSwitch('es')}`;
const enPath = `${siteUrl}${getLocalizedPathForSwitch('en')}`;
const frPath = `${siteUrl}${getLocalizedPathForSwitch('fr')}`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Brand Favicons -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    
    <title>{title} | Cesar Santos - Fisioterapia y Salud</title>

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="PENDIENTE" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- International SEO Hreflang Tags for Search Engines -->
    <link rel="alternate" hreflang="es" href={esPath} />
    <link rel="alternate" hreflang="en" href={enPath} />
    <link rel="alternate" hreflang="fr" href={frPath} />
    <link rel="alternate" hreflang="x-default" href={enPath} />
    
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Cesar Santos`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Cesar Santos`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MX78Z636');</script>
    <!-- End Google Tag Manager -->

    <!-- JSON-LD Structured Data Schema -->
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

    <!-- Google Fonts Preconnect & Inter / Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Inline Script for Theme Prevention of Flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Automatic Browser Language Detection & International Redirection Script (Root Only) -->
    <script is:inline define:vars={{ esPath, enPath, frPath, currentLang: lang }}>
      (function() {
        // Do not redirect bots, search engine crawlers, or direct path navigations
        const userAgent = (navigator.userAgent || '').toLowerCase();
        if (/bot|googlebot|crawler|spider|robot|crawling/i.test(userAgent)) return;

        // Only auto-redirect on the root entrance page ('/' or '/index.html')
        const rawPath = window.location.pathname.replace(/\/+$/, '') || '/';
        const isRoot = (rawPath === '/' || rawPath === '/index.html' || rawPath === '');
        if (!isRoot) return;

        // Check if user has a manually saved language preference
        const savedLang = localStorage.getItem('preferred-lang');
        
        let targetLang = currentLang;

        if (savedLang && ['es', 'en', 'fr'].includes(savedLang)) {
          targetLang = savedLang;
        } else {
          // Detect browser language
          const browserLangs = navigator.languages || [navigator.language || ''];
          let detected = '';

          for (let i = 0; i < browserLangs.length; i++) {
            const l = (browserLangs[i] || '').toLowerCase();
            if (l.startsWith('es')) {
              detected = 'es';
              break;
            } else if (l.startsWith('fr')) {
              detected = 'fr';
              break;
            } else if (l.startsWith('en')) {
              detected = 'en';
              break;
            }
          }

          // Default all other non-Spanish and non-French international visitors to English ('en')
          if (!detected) {
            detected = 'en';
          }

          targetLang = detected;
        }

        // Redirect on root if targetLang is not Spanish ('es' is default root)
        if (targetLang !== currentLang && targetLang !== 'es') {
          const targetUrl = targetLang === 'en' ? enPath : frPath;
          if (targetUrl) {
            try {
              const urlObj = new URL(targetUrl);
              if (urlObj.pathname !== window.location.pathname && urlObj.pathname !== window.location.pathname + '/') {
                window.location.replace(urlObj.pathname);
              }
            } catch (e) {
              if (targetUrl !== window.location.pathname) {
                window.location.replace(targetUrl);
              }
            }
          }
        }
      })();
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MX78Z636"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Skip to Content Link for WAI-ARIA Accessibility -->
    <a href="#main-content" class="skip-link">{t('skipToContent')}</a>

    <!-- Header Section -->
    <header class="site-header">
      <div class="header-container">
        <!-- Brand Identity / Logo -->
        <a href={getLocalizedPath('/', lang)} class="brand-link" aria-label="Cesar Santos Fisioterapia y Salud Home">
          <img 
            src={`${import.meta.env.BASE_URL}LOGO/logo_light.webp`} 
            alt="Cesar Santos - Fisioterapia y Salud" 
            class="brand-logo-img logo-light-img" 
            width="128"
            height="120"
          />
          <img 
            src={`${import.meta.env.BASE_URL}LOGO/logo_dark.webp`} 
            alt="Cesar Santos - Fisioterapia y Salud" 
            class="brand-logo-img logo-dark-img" 
            width="128"
            height="120"
          />
        </a>

        <!-- Accessibility-optimised Navigation -->
        <nav aria-label={lang === 'es' ? 'Navegación principal' : lang === 'en' ? 'Main navigation' : 'Navigation principale'} class="nav-controls">
          <ul class="main-nav-list">
            <li>
              <a href={getLocalizedPath('/sobre-mi', lang)} class={`nav-link ${Astro.url.pathname.includes('sobre-mi') || Astro.url.pathname.includes('about-me') || Astro.url.pathname.includes('a-propos') ? 'active' : ''}`}>
                {t('nav.about')}
              </a>
            </li>
            <li>
              <a href={getLocalizedPath('/desmitificando-el-dolor', lang)} class={`nav-link ${Astro.url.pathname.includes('desmitificando-el-dolor') || Astro.url.pathname.includes('demystifying-pain') || Astro.url.pathname.includes('demystifier-la-douleur') ? 'active' : ''}`}>
                {t('nav.repo')}
              </a>
            </li>
            <li>
              <a href={getLocalizedPath('/guia-afrontamiento', lang)} class={`nav-link ${Astro.url.pathname.includes('guia-afrontamiento') || Astro.url.pathname.includes('coping-guide') || Astro.url.pathname.includes('guide-adaptation') ? 'active' : ''}`}>
                {t('nav.guide')}
              </a>
            </li>
            <li>
              <a href={getLocalizedPath('/contacto', lang)} class={`nav-link ${Astro.url.pathname.includes('contacto') || Astro.url.pathname.includes('contact') ? 'active' : ''}`}>
                {t('nav.contact')}
              </a>
            </li>
          </ul>

          <div class="picker-container">
            <!-- Social Media links -->
            <div class="social-header-links">
              <a href="https://youtube.com/@cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="YouTube">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.5 12 3.5 12 3.5s-7.518 0-9.388.553a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.553 9.388.553 9.388.553s7.518 0 9.388-.553a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
              <a href="https://instagram.com/cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Instagram">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                </svg>
              </a>
              <a href="https://tiktok.com/@cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="TikTok">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.99-1.72-.08-.07-.17-.17-.24-.26v8.44c.02 3.71-2.9 7.02-6.61 7.54-3.82.53-7.58-1.92-8.54-5.63-1.07-4.14 1.25-8.56 5.39-9.63 1.17-.3 2.4-.33 3.59-.08V8.98c-1.89-.5-3.97.1-5.18 1.64-1.21 1.54-1.39 3.73-.48 5.48.91 1.75 2.89 2.8 4.88 2.64 2.51-.2 4.45-2.51 4.29-5.02V.02z"/>
                </svg>
              </a>
              <a href="https://linkedin.com/in/cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            </div>

            <!-- Theme Toggle Button -->
            <button 
              id="theme-toggle" 
              aria-label={t('themeToggle')}
              class="btn-icon"
            >
              <!-- Sun Icon -->
              <svg id="theme-toggle-light-icon" class="hidden" style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
              </svg>
              <!-- Moon Icon -->
              <svg id="theme-toggle-dark-icon" class="hidden" style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
              </svg>
            </button>

            <!-- Language Picker -->
            <div class="lang-picker-wrapper">
              <button 
                id="lang-menu-button"
                aria-label={t('lang.label')}
                class="btn-lang"
              >
                {lang}
              </button>
              <ul 
                id="lang-menu"
                class="lang-dropdown"
                aria-label={t('lang.label')}
              >
                <li>
                  <a href={getLocalizedPathForSwitch('es')} class="lang-dropdown-link" data-lang="es">
                    Español (ES)
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPathForSwitch('en')} class="lang-dropdown-link" data-lang="en">
                    English (EN)
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPathForSwitch('fr')} class="lang-dropdown-link" data-lang="fr">
                    Français (FR)
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content landmark -->
    <main id="main-content" class="main-content container" tabindex="-1">
      <slot />
    </main>

    <!-- Footer landmark -->
    <footer class="site-footer">
      <div class="footer-container container">
        <div>
          <p>{t('footer.copyright', { year: new Date().getFullYear() })}</p>
          <p style="font-size: 0.75rem; margin-top: 5px; color: var(--text-muted);">
            {lang === 'es' ? 'Fisioterapia Basada en la Evidencia · Ejercicio Terapéutico y PNI Clínica' : lang === 'en' ? 'Evidence-Based Physiotherapy · Therapeutic Exercise & Clinical PNI' : 'Physiothérapie Basée sur las Preuves · Exercice Thérapeutique & PNI Clinique'}
          </p>
        </div>

        <!-- Social Media Footer links -->
        <div class="social-footer-links">
          <a href="https://youtube.com/@cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.5 12 3.5 12 3.5s-7.518 0-9.388.553a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.553 9.388.553 9.388.553s7.518 0 9.388-.553a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          <a href="https://instagram.com/cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>
          <a href="https://tiktok.com/@cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.99-1.72-.08-.07-.17-.17-.24-.26v8.44c.02 3.71-2.9 7.02-6.61 7.54-3.82.53-7.58-1.92-8.54-5.63-1.07-4.14 1.25-8.56 5.39-9.63 1.17-.3 2.4-.33 3.59-.08V8.98c-1.89-.5-3.97.1-5.18 1.64-1.21 1.54-1.39 3.73-.48 5.48.91 1.75 2.89 2.8 4.88 2.64 2.51-.2 4.45-2.51 4.29-5.02V.02z"/>
            </svg>
          </a>
          <a href="https://linkedin.com/in/cesarsantos" target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>

        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; align-items: center;">
          <a href={getLocalizedPath('/aviso-legal', lang)} style="font-size: 0.8rem; text-decoration: underline; color: var(--text-muted);">{t('footer.legal')}</a>
          <span style="font-size: 0.8rem; color: var(--border-color);">·</span>
          <button id="open-cookies-btn" type="button" style="background: none; border: none; padding: 0; font-size: 0.8rem; text-decoration: underline; color: var(--text-muted); cursor: pointer; font-family: inherit;">
            {t('footer.cookies')}
          </button>
        </div>
      </div>
    </footer>

    <!-- Accessible Theme Toggle and Dropdown scripts -->
    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

      // Change the icons inside the button based on current state
      if (document.documentElement.classList.contains('dark')) {
        themeToggleLightIcon?.classList.remove('hidden');
        themeToggleDarkIcon?.classList.add('hidden');
      } else {
        themeToggleDarkIcon?.classList.remove('hidden');
        themeToggleLightIcon?.classList.add('hidden');
      }

      themeToggleBtn?.addEventListener('click', function() {
        document.documentElement.classList.toggle('dark');

        if (document.documentElement.classList.contains('dark')) {
          localStorage.setItem('theme', 'dark');
          themeToggleLightIcon?.classList.remove('hidden');
          themeToggleDarkIcon?.classList.add('hidden');
          themeToggleBtn.setAttribute('aria-pressed', 'true');
        } else {
          localStorage.setItem('theme', 'light');
          themeToggleDarkIcon?.classList.remove('hidden');
          themeToggleLightIcon?.classList.add('hidden');
          themeToggleBtn.setAttribute('aria-pressed', 'false');
        }
      });

      // Accessible Language Pick Menu dropdown toggling
      const langMenuBtn = document.getElementById('lang-menu-button');
      const langMenu = document.getElementById('lang-menu');

      langMenuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        langMenu?.classList.toggle('show');
        const isShown = langMenu?.classList.contains('show');
        langMenuBtn.setAttribute('aria-expanded', isShown ? 'true' : 'false');
      });

      document.addEventListener('click', () => {
        langMenu?.classList.remove('show');
        langMenuBtn?.setAttribute('aria-expanded', 'false');
      });

      langMenu?.addEventListener('focusout', () => {
        setTimeout(() => {
          if (!langMenu.contains(document.activeElement)) {
            langMenu.classList.remove('show');
            langMenuBtn?.setAttribute('aria-expanded', 'false');
          }
        }, 10);
      });

      // Save user language preference on manual click
      document.querySelectorAll('.lang-dropdown-link').forEach(link => {
        link.addEventListener('click', () => {
          const l = link.getAttribute('data-lang');
          if (l) {
            localStorage.setItem('preferred-lang', l);
          }
        });
      });
    </script>
    <CookieConsent lang={lang} />
  </body>
</html>
